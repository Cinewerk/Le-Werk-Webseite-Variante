# Unbearbeitete Lieferungen im Bildordner.
#
# public/ wird unverändert ausgeliefert: Was hier liegt und einmal
# committet wird, steht auf der öffentlichen Seite — auch das, was nur
# zum Aussuchen dagelegt wurde. In der Lieferung vom 6. August 2026
# waren acht private Urlaubsbilder dabei.
#
# Die Webfassungen tragen die Namen der Datenliste (bts-*, haus-*) und
# bleiben davon unberührt.
public/images/bts/WhatsApp*
public/images/bts/Büro_*
public/images/bts/bts.jpg
public/images/bts/bts2.jpg
public/images/bts/bts3.jpg
