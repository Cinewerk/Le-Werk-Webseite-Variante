---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { arbeiten } from '../data/arbeiten';
import { withBase } from '../lib/paths';

// Der Dateiname des Bühnenvideos ist bewusst neutral gehalten: Er steht im
// Quelltext jeder Seite, und laut Markenarchitektur wird die Schwestermarke
// ausschließlich im Impressum genannt. Details in docs/bildmaterial.md.

// Die Kundenlogos, einzeln statt als ein Streifenbild. Sie stehen seit
// dem 7. August 2026 als Raster unter den Arbeiten und nicht mehr als
// laufende Leiste in einem eigenen Abschnitt — Begründung im Markup bei
// .kundschaft. Die Liste läuft damit nur noch einmal durch; die zweite,
// stumme Runde für den nahtlosen Umbruch der Endlosschleife ist entfallen.
//
// Die Größe steckt nicht in diesen Daten, sondern in einem Kasten im CSS:
// Jedes Logo bekommt dieselbe Höchstbreite und dieselbe Höchsthöhe und
// wächst darin so weit, wie es sein Seitenverhältnis zulässt. Breite
// Wortmarken stoßen an die Breite, hohe Bildmarken an die Höhe.
//
// Das ist die Ordnung, die der frühere Streifen hatte — nachgemessen an
// dessen Bilddatei: Siemens, Douglas, Street One und Seven.One standen
// dort alle zwischen 80 und 120px breit, Zehnder als einzige hohe Marke
// bei 63 x 54. Auf gleiche Höhe gebracht wären die Wortmarken dreimal so
// schwer wie die Bildmarken.
//
// b und h sind die Maße der freigestellten Dateien und stehen nur wegen
// des width/height-Attributs hier — sie verhindern, dass die Zeile beim
// Laden springt. Freigestellt heißt: auf den Kasten beschnitten, in dem
// überhaupt Farbe steht. Die Lieferung hatte sehr unterschiedlich viel
// durchsichtigen Rand — Siemens stand in einem 2400er Quadrat, in dem die
// Wortmarke nur 364px hoch war.
//
// url führt auf die Seite des Unternehmens. Jede Adresse ist per Abruf
// geprüft; zwei Anmerkungen dazu:
//
//   douglas.de   antwortet einem Abruf ohne Browser mit 400. Das ist ein
//                Bot-Schutz, keine tote Adresse — DNS, TLS und die
//                Umleitung auf www greifen. douglas.com wäre falsch, die
//                Adresse führt zu einer gleichnamigen Firma in Kanada.
//   olympics.com bricht denselben Abruf ab, ist aber belegt: olympic.org
//                leitet mit 301 genau dorthin.
//
// Wo es eine deutsche Fassung gibt, steht sie hier — siemens.de leitet
// sauber auf siemens.com/de-de.
// Bezugskasten für das Raster. Der Wert steht hier und in
// .kundschaft__raster als --logo-breite; das Verhältnis 2.35 verbindet
// beide.
const LOGO_VERHAELTNIS = 94 / 40;

// Wie breit ein Logo im Verhältnis zur vollen Kastenbreite läuft. Breite
// Wortmarken bekommen die ganze Breite, hohe Bildmarken so viel, wie ihre
// Höhe zulässt.
//
// Gerechnet statt eingetragen, damit der Wert beim Austausch einer Datei
// nicht veraltet — er hängt nur an b und h.
//
// Warum überhaupt je Logo: Eine feste Kastenbreite für alle sah aus wie
// unterschiedliche Abstände. Ein schmales Logo saß mittig in einem 94px
// breiten Kasten und brachte bis zu 55px Leerraum mit, der sich zur Lücke
// addierte — gemessen zwischen 38px und 87px. Und der naheliegende Weg
// über max-width geht nicht: Bindet max-width, rechnet der Browser die
// Höhe nicht zurück, die Wortmarken werden auf volle Kastenhöhe gezogen.
//
// weite ist die Ausnahme von der Regel und steht deshalb je Logo in den
// Daten, nicht hier: Sie lässt eine Marke breiter laufen als den Kasten.
// Gebraucht wird das von den beiden längsten Wortmarken, Johnson &
// Johnson und HUGO BOSS — jenseits von etwa 7 : 1 fällt ein Logo im
// Kasten unter 12px Höhe und damit unter die übrigen Wortmarken.
const logoBreite = (k) =>
  (Math.min(1, k.b / k.h / LOGO_VERHAELTNIS) * (k.weite ?? 1)).toFixed(4);

const kunden = [
  { datei: 'siemens',     name: 'Siemens',                      url: 'https://www.siemens.de/',          b: 330, h:  51 },
  { datei: 'street-one',  name: 'Street One',                   url: 'https://www.street-one.de/',       b: 330, h:  48 },
  { datei: 'douglas',     name: 'Douglas',                      url: 'https://www.douglas.de/',          b: 330, h:  61 },
  { datei: 'allianz',     name: 'Allianz',                      url: 'https://www.allianz.de/',          b: 330, h:  86 },
  { datei: 'olympia',     name: 'Olympische Spiele',            url: 'https://www.olympics.com/',        b: 252, h: 118 },
  { datei: 'paralympics', name: 'Paralympisches Komitee',       url: 'https://www.paralympic.org/',      b: 192, h: 141 },
  { datei: 'ea',          name: 'EA',                           url: 'https://www.ea.com/de-de',         b: 159, h: 160 },
  { datei: 'formel-d',    name: 'Formel D',                     url: 'https://www.formeld.com/de/',      b: 189, h: 143 },
  { datei: 'sevenone',    name: 'Seven.One Entertainment Group', url: 'https://www.seven.one/',           b: 330, h:  74 },
  { datei: 'zehnder',     name: 'Zehnder Group',                url: 'https://www.zehndergroup.com/',    b: 171, h: 152 },
  // Zweite Marke mit weite: 8,3 : 1, im Kasten 10px hoch und damit die
  // kleinste Schrift der Leiste — kleiner als Johnson & Johnson nach
  // deren Korrektur, was die Reihenfolge der Ausnahmen auf den Kopf
  // stellen würde. 1.19 hebt sie auf dieselben 12px, sie läuft dafür
  // 100px breit statt 84.
  { datei: 'hugo-boss',   name: 'HUGO BOSS',                    url: 'https://www.hugoboss.com/de/',     b: 200, h:  24, weite: 1.19 },
  // Mit 10,7 : 1 die mit Abstand breiteste Marke; im Kasten käme sie auf
  // 8px Höhe — halb so hoch wie Douglas und kaum noch lesbar. Der Faktor
  // 1.52 hebt sie auf 12px und damit auf dieselbe Höhe wie Street One.
  // Sie läuft dafür 128px breit statt 84; das ist der Preis und bei einer
  // so langen Wortmarke vertretbar.
  { datei: 'johnson-johnson', name: 'Johnson & Johnson',        url: 'https://www.jnj.com/de-de',        b: 330, h:  31, weite: 1.52 },
];

// Die fünf Projekte liegen in src/data/arbeiten.ts, weil die Unterseiten
// unter /arbeiten/<slug> dieselben Angaben brauchen.

// Auf der Startseite erscheinen nur die drei Produktionsdisziplinen.
// Workshops bleiben über Menü, Footer und /services erreichbar.
//
// Eigene Reihenfolge, weil die Kästen hier anders liegen: Video groß links,
// Idee & Konzept rechts oben, Foto rechts unten. Sie steht über die Adresse
// und nicht über den Listenplatz — sonst würde eine Umsortierung in
// services.ts das Layout still verschieben.
// Die Reihenfolge ist der Arbeitsweg und nicht die Wichtigkeit: erst die
// Idee, dann der Dreh, dann das Bild. Seit die Liste nummeriert ist, muss
// sie das auch sein — eine Nummer behauptet eine Folge.
const reihenfolge = ['/services/konzept', '/services/video', '/services/foto'];
const disziplinen = services
  .filter((s) => s.disziplin)
  .sort((a, b) => reihenfolge.indexOf(a.href) - reihenfolge.indexOf(b.href));

// Die Kulisse unter den Porträts: zwölf Aufnahmen aus dem Studio und vom
// Set, dazwischen die beiden Sätze, die den Abschnitt tragen.
//
// AUFBAU. Vier Spalten, drei volle Reihen, die Reihen versetzt. Die
// beiden Textfelder stehen dort, wo sonst ein Hochformat stünde, und
// nehmen dessen Maße an — sie sind Kacheln im Feld, keine Absätze daneben.
// Jeder Satz sitzt zwischen den Aufnahmen, die zu ihm gehören:
//
//   Reihe 1   Halle · Transporter · SATZ 01 · Regie       (alles vom Set)
//   Reihe 2   Schnitt · Loft · Studio · Büro               (Arbeit und Haus)
//   Reihe 3   Krafthaus · SATZ 02 · Feierabend · Drohne    (alles vom Ort)
//
// Zwölf Plätze für zehn Aufnahmen und zwei Sätze. Entfallen sind dafür
// vier Bilder: die schwarzweiße Autobahn und die alte Bürowand (beide
// die schwächsten ihrer Reihe), dazu am 6. August 2026 der Sattelzug an
// der Raststätte und der grüne Sessel — für die kamen zwei neue
// Aufnahmen herein, die dasselbe besser zeigen:
//
//   Empfang       →  Büro im Krafthaus
//                    Derselbe Raum, aber ganz: die grünen Sessel, der
//                    Flipper, das Rundbogenfenster und das Licht darauf.
//                    Der Sessel allein vor weißer Wand war ein Ausschnitt.
//   Raststätte    →  Ansage vor dem Take
//                    Ein Sattelzug zeigt eine Fahrt, keine Produktion.
//                    Die neue Aufnahme zeigt beides, was hier zu zeigen
//                    ist: jemanden an der Kamera und jemanden, der sagt,
//                    was gedreht wird.
//
// Damit trägt Reihe 1 dreimal Set statt zweimal, und die Ortsangaben
// stehen gesammelt in Reihe 3 beim Satz, der von ihnen spricht.
//
// Der Platz jedes Stücks entsteht aus seiner Nummer in der Liste; die
// Spalte rechnet das Frontmatter mit, weil der Versatz je Spalte daran
// hängt.
//
// FORMATE. Zwei statt sechs, wie bei Featured Work: Was quer aufgenommen
// ist, steht als 4:3, was hoch aufgenommen ist, als 3:4. Die wahren
// Seitenverhältnisse (3:2, 2:3, 5:4, 3:4) ließen die Reihen so ungleich
// laufen, dass der Versatz nicht mehr als Muster lesbar wäre.
//
// Die frühere Fassung — zwei Streublöcke mit je einem Haufen aus sechs
// überlappenden Stücken und dem Text daneben, jedes Stück mit x/y/w/z und
// einem aus der Lage gerechneten Streuweg — ist damit abgelöst. Ihre
// Maße stehen in der Git-Historie.
//
// DIE BESCHRIFTUNGEN SIND MEINE FORMULIERUNG und benennen nur, was zu
// sehen ist. Sie stehen hier an einer Stelle und lassen sich austauschen,
// ohne das Layout anzufassen. Eine Jahreszahl steht bewusst nicht dabei —
// die ist zu keiner der Aufnahmen bekannt; die laufende Nummer nimmt
// ihren Platz ein.
//
// Von den zwölf gelieferten BTS-Dateien sind sechs nicht verwendet: vier
// sind private Aufnahmen, zwei zeigen dasselbe Studio wie bts-studio, nur
// enger. Die sechs Haus-Aufnahmen kommen unverändert vom Kunden.
const kulisseRoh = [
  { img: '/images/bts/bts-halle.jpg',       hoch: false, pille: 'Dreh',      titel: 'Werkhalle',            alt: 'Dreiköpfiges Team in einer Werkhalle: einer beugt sich über die Kamera auf dem Stativ, dahinter ein Monitorplatz und eine Softbox' },
  { img: '/images/bts/bts-transporter.jpg', hoch: true,  pille: 'Unterwegs', titel: 'Zwischen zwei Sets',   alt: 'Zwei Frauen sitzen mit einem Laptop im Transporter, die Schiebetür steht offen, dahinter eine Tankstelle' },
  {
    // Satz 01 — steht zwischen den Set-Aufnahmen, weil er von der
    // Zusammensetzung des Teams spricht, und belegt dort den Platz eines
    // Hochformats.
    text: 'team',
    ressort: 'Team',
    vorspann: 'Erfahrung aus hunderten Produktionen',
    satz: 'Wir kombinieren ein schlagkräftiges Kernteam mit kreativen Spezialisten aus verschiedenen Feldern.',
  },
  { img: '/images/bts/bts-regie.jpg',       hoch: false, pille: 'Dreh',      titel: 'Ansage vor dem Take',  alt: 'Zwei Männer bei der Arbeit: einer trägt die Kamera auf dem Körperstativ, der andere erklärt mit beiden Händen die nächste Einstellung' },

  { img: '/images/bts/bts-schnitt.jpg',     hoch: true,  pille: 'Post',      titel: 'Schnittplatz',         alt: 'Zwei Personen am Schnittplatz vor mehreren Monitoren, daneben ein Fenster mit Zimmerpflanzen' },
  { img: '/images/bts/bts-loft.jpg',        hoch: false, pille: 'Dreh',      titel: 'Körperstativ im Loft', alt: 'Zwei Personen an einer Kamera auf dem Körperstativ in einem hellen Studio' },
  { img: '/images/bts/bts-studio.jpg',      hoch: false, pille: 'Dreh',      titel: 'Aufbau vor Blau',      alt: 'Studioaufbau vor blauer Wand: ein weißer Hocker, zwei Kameras auf Stativen, Softboxen und eine Tonangel über orangem Bodenband' },
  { img: '/images/krafthaus/haus-buero.jpg', hoch: true, pille: 'Haus',      titel: 'Büro im Krafthaus',    alt: 'Büroecke im Krafthaus: zwei grüne Sessel und ein Flipperautomat vor einem hohen Rundbogenfenster, an der Wand gerahmte Plakate' },

  { img: '/images/krafthaus/haus-01.jpg',   hoch: false, pille: 'Haus',      titel: 'Krafthaus am Abend',   alt: 'Das Krafthaus im Abendlicht, dahinter das Kranhaus am Rheinauhafen' },
  {
    // Satz 02 — zwischen den Haus-Aufnahmen, weil er vom Ort spricht.
    text: 'ort',
    ressort: 'Standort',
    vorspann: 'Based in Köln, booked worldwide',
    satz: 'Unsere Räumlichkeiten liegen im Krafthaus, im Rheinauhafen. Gedreht wird in Köln, bundesweit oder auch international.',
  },
  { img: '/images/krafthaus/haus-06.jpg',   hoch: true,  pille: 'Haus',      titel: 'Feierabend',           alt: 'Mehrere Personen an Biertischen vor einem Lokal, eine Person lacht in die Kamera' },
  { img: '/images/krafthaus/haus-drohne.jpg', hoch: false, pille: 'Haus',    titel: 'Rheinauhafen',         alt: 'Luftaufnahme des Krafthauses im Rheinauhafen: Backsteinbau mit Schieferdach, daneben Kopfsteinpflaster und die Nachbargebäude' },
];

// Die Spalte je Stück, nach derselben Regel, nach der der Browser die
// Plätze vergibt: der Reihe nach, und was nicht mehr in die angefangene
// Reihe passt, beginnt die nächste. Ein Textfeld belegt einen Platz wie
// jede Aufnahme auch.
//
// Gerechnet statt eingetragen, weil der Versatz je Spalte daran hängt —
// eine eingetragene Spaltenzahl wäre nach der ersten Umsortierung falsch,
// ohne dass es jemandem auffiele.
//
// Die laufende Nummer zählt nur die Aufnahmen; die beiden Textfelder
// tragen keine.
const KULISSE_SPALTEN = 4;
let kulisseNr = 0;
const kulisse = kulisseRoh.map((k, i) => ({
  ...k,
  spalte: (i % KULISSE_SPALTEN) + 1,
  nr: k.text ? null : String(++kulisseNr).padStart(2, '0'),
}));

// Vier Plätze, alle vier echt. Der Zuschnitt steckt in der Datei und
// nicht im CSS, weil die Aufnahmen quer oder hoch sind und die Personen
// klein im Raum zeigen — ein Beschnitt per object-fit hätte sie nur
// verschoben, nicht näher herangeholt.
//
// ZWEI MASSE HALTEN DIE REIHE ZUSAMMEN, und beide sind nachgemessen:
//
//   AUGENLINIE 44 %   Die Augen liegen bei allen vier auf 44 Prozent der
//                     Kachelhöhe. Vorher lagen sie zwischen 22 und 37 —
//                     der Blick sprang beim Wechsel um rund 45px.
//
//   KOPFHÖHE 178 px   Vom Scheitel bis zum Kinn, gerechnet auf die
//                     Anzeigegröße von 304px. Gemessen liegen die vier
//                     bei 177 bis 179, also innerhalb von einem Prozent.
//
// Das zweite Maß ist das jüngere. Eine gemeinsame Augenlinie allein
// reicht nicht: Danach lagen die Augen zwar auf einer Linie, die Köpfe
// waren aber 92 bis 174px hoch — Joschas fast doppelt so groß wie Cems.
// Die Reihe las sich als vier verschiedene Aufnahmen, nicht als ein Satz.
//
// Die Grenzen für die beiden Werte:
//
//   nach unten   Cem für die Augenlinie: Bei ihm liegen zwischen Scheitel
//                und Augen 59 Prozent der Kopfhöhe, tiefer angesetzt
//                stößt er oben an. Bei 44 Prozent bleiben ihm 33px Luft.
//   nach oben    Joscha für die Kopfhöhe: Seine Quelle ist nur 1086px
//                breit, der Ausschnitt schöpft sie fast aus. Kleiner als
//                177 lässt sich sein Kopf nicht mehr schneiden.
//
// Eine dritte Grenze ist entfallen: Von Philipp gab es lange nur die
// 700er Webfassung, sein Ausschnitt konnte weder nach unten wandern noch
// weiter aufgezogen werden, und seine Kachel maß deshalb nur 524px. Seit
// dem 4. August 2026 liegt sein Original vor (2880 x 1920), und alle vier
// Kacheln sind 700px groß — bei 304px Anzeige also 2,3-fach.
//
// Wer ein Porträt tauscht, muss den Schnitt mitliefern: quadratisch,
// Augen auf 44 Prozent, Kopf 58 Prozent der Kachelhöhe.
//
// Die Originale liegen alle vier unter quellbilder/team.
//
// Die Rollen sind Doppelnennungen, getrennt durch einen senkrechten
// Strich. Der Strich steht nur noch in den Daten: Die Vorlage teilt an ihm
// und setzt die beiden Hälften untereinander — Begründung bei .team__zeile
// im Stylesheet. Er bleibt hier, weil er die Trennstelle bezeichnet, und
// eine Zeichenkette mit klarer Trennstelle ist leichter zu pflegen als
// zwei Felder.
//
// Zwei Sonderzeichen sind trotzdem nötig:
//
//   U+2011   steht als Bindestrich in "Post‑Production" und
//            "Self‑Shooting" — ein gewöhnlicher Bindestrich ist eine
//            Trennstelle, und Joschas Zeile brach genau dort: "Head of
//            Post-" über "Production". Der Umbruch gehört zwischen die
//            beiden Nennungen, nicht in einen Begriff.
//   U+2009   steht als schmales Leerzeichen um den Strich. Beim Teilen
//            fällt es mit weg; es trägt nur, solange die Zeichenkette
//            ungeteilt irgendwo auftaucht.
const team = [
  { img: '/images/team/philipp-maxhofer.jpg', name: 'Philipp Maxhofer', role: 'Concept | Creative Director', alt: 'Porträt von Philipp Maxhofer im Rollkragenpullover, Studio im Hintergrund' },
  { img: '/images/team/cem-schuch.jpg', name: 'Cem-Pierre Schuch', role: 'Head of Production | Self‑Shooting Director', alt: 'Porträt von Cem-Pierre Schuch in dunkler Sweatjacke, lachend, im Hintergrund ein Sprossenfenster' },
  { img: '/images/team/joscha-ortmeier.jpg', name: 'Joscha Ortmeier', role: 'Head of Post‑Production | Photographer', alt: 'Porträt von Joscha Ortmeier mit Brille, im Hintergrund ein Bücherregal' },
  { img: '/images/team/tom-beckers.jpg', name: 'Tom Beckers', role: 'Producer | Content Creator', alt: 'Porträt von Tom Beckers mit schulterlangem Haar und Schnurrbart, im Hintergrund ein helles Fenster' },
];

// q darf Markup enthalten (Wortmarke), wird unten mit set:html gerendert.
//
// Von zehn Fragen auf fünf gekürzt. Entfallen sind die zu Werbefilm in
// 16:9, Mediaplanung und SEO, Köln als Arbeitsgebiet, Nutzungsrechten
// und Workshops.
//
// Zwei davon trugen die Abgrenzung "was wir nicht machen" — sie steckt
// jetzt nur noch in Frage 2 zu UGC. Wer die Abgrenzung deutlicher will,
// muss sie dort schärfen oder eine der beiden Fragen zurückholen; sie
// stehen in der Git-Historie.
const faqs = [
  { q: 'Was kostet eine Produktion bei <span class="brand">Le Werk</span>?', a: 'Das hängt an Drehtagen, Team und Formatumfang. Kompakte Social-Produktionen starten im mittleren vierstelligen Bereich, größere Kampagnen liegen fünfstellig. Nach einem 20-minütigen Gespräch bekommt ihr eine belastbare Spanne — kein Zahlenraten.' },
  { q: 'Macht ihr auch UGC- oder Handy-Content?', a: 'Nein. Das ist ein anderer Markt mit anderen Preisen und anderem Anspruch. Bei uns entstehen Visuals auf Kampagnenniveau — auch dann, wenn sie am Ende vertikal im Feed laufen. Wer schnellen, günstigen Durchsatz sucht, ist bei uns falsch.' },
  { q: 'Bekommen wir Foto und Video aus einer Produktion?', a: 'Ja, das ist der Kern unserer Arbeitsweise. Wir planen Sets so, dass bewegte und stehende Bilder parallel entstehen. Das spart einen kompletten Produktionstag und sorgt dafür, dass Foto und Video wie eine Kampagne aussehen — nicht wie zwei.' },
  { q: 'Warum denkt ihr vom vertikalen Format aus?', a: 'Weil dort die Aufmerksamkeit liegt. Ein Bildaufbau, der als 16:9 entsteht und später hochkant beschnitten wird, verliert immer — Blickführung, Text und Rhythmus stimmen dann nicht mehr. Wir planen umgekehrt: vertikal als Kern, Landscape und Stills als Ableitung derselben Produktion.' },
  { q: 'Wie lange dauert es von der Anfrage bis zum fertigen Material?', a: 'Für eine kompakte Produktion rechnet mit drei bis vier Wochen: eine Woche Konzept, ein bis zwei Drehtage, ein bis zwei Wochen Post. Bei laufenden Content-Paketen verkürzt sich das deutlich, weil Setup und Look bereits stehen.' },
];
---

<BaseLayout
  title="Le Werk — Visual Content Studio für Video und Fotografie"
  description="Le Werk ist ein Visual Content Studio in Köln: Video und Fotografie auf Kampagnenniveau, vom vertikalen Format aus gedacht. Handwerk mit redaktioneller Substanz — kein UGC, kein Full-Service-Overhead."
  heroDark={true}
>
  <!-- ═══ 1 · HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <!-- muted und playsinline sind Bedingung dafür, dass mobile Browser
           überhaupt selbst starten. Die Datei hat keine Tonspur.
           Bei prefers-reduced-motion hält ein Skript das Video an. -->
      <video
        id="hero-video"
        autoplay muted loop playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={withBase('/videos/lewerk-hero.mp4')} type="video/mp4" />
      </video>
    </div>

    <!-- Text sitzt in der unteren linken Ecke und läuft bewusst nicht über
         die ganze Breite. Randabstand = --edge, damit er mit dem Logo im
         Header auf einer Achse liegt.

         DER SATZ STEHT IN ZWEI MASKEN, eine je Hälfte — Gattung vorn,
         Behauptung hinten. Sie tun zwei Dinge auf einmal:

           Sie teilen   Der Umbruch nach "studio" steckt in der Struktur
                        statt in einem <br>, das unter 820px wieder weg
                        müsste. Jede Hälfte bricht darin selbst um, so
                        breit das Fenster gerade ist.
           Sie tragen   Beim Laden steigt jede Hälfte aus ihrer Maske
                        herauf, versetzt. Die Maske ist der Grund, warum
                        man sie vorher nicht sieht — der Satz kommt nicht
                        aus dem Nichts, sondern aus dem Bild heraus.

         Von unten und nicht eingeblendet: Ein Studio, das Filme macht,
         zieht seinen Titel herauf wie einen Vorspann. -->
    <div class="hero__inner">
      <h1 class="hero__statement" id="hero-title" lang="en">
        <span class="hero__zeile" style="--zeile: 0"><span>
          <span class="brand">Le Werk</span> is a visual content studio
        </span></span>
        <span class="hero__zeile" style="--zeile: 1"><span>
          crafting brand content <em>worth watching.</em>
        </span></span>
      </h1>
    </div>

    <a class="hero__cue" href="#positionierung" aria-label="Weiter zum Inhalt scrollen">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ═══ 2 · POSITIONIERUNG ═════════════════════════════════════════════ -->
  <section class="section statement" id="positionierung" aria-labelledby="statement-title">
    <div class="container container--breit statement__inner">
      <!-- Bewusst kein deutscher Claim: Laut Positionierung trägt der
           englische Positions-Satz im Hero diese Rolle, ein Manifest-Satz
           auf Deutsch steht noch aus. Dieser Absatz erklärt die Position,
           er behauptet sie nicht als Slogan. -->
      <!-- Der komplette Positionstext, seit dem 6. August 2026 wieder mit
           Gattung und Ort — so war er in Entwurf 04c-XII abgenommen.
           Kursiv (Bodoni) laufen nur noch die drei Disziplinen; Auftakt
           und Schluss stehen aufrecht im Grotesk. Das geschützte
           Leerzeichen nach dem Auftakt hält ihn an "Le Werk" — sonst
           stünde "Gegründet von Filmemachern." allein auf einer Zeile.

           Kein data-reveal an beiden Absätzen: Die Wörter stehen von
           Anfang an, nur gedimmt, und färben sich beim Scrollen der Reihe
           nach auf — das Skript dazu steht am Ende der Datei. Zwei
           Mechaniken auf demselben Absatz überlagerten sich. -->
      <p class="statement__text" id="statement-title">
        <em>Gegründet von Filmemachern.</em>{' '}
        <span class="brand">Le Werk</span> ist ein Visual Content Studio mit
        Sitz im Rheinauhafen in Köln. Spezialisiert auf{' '}
        <i class="statement__kursiv">Storytelling, Film und Foto</i> für{' '}
        <em class="statement__leistung"><strong>Social</strong> und Branded Content.</em>
      </p>
      <p class="statement__meta">
        Konzept · Produktion · Postproduktion · Based in Köln, Booked Worldwide
      </p>
    </div>
  </section>

  <!-- ═══ 3 · FEATURED WORK ══════════════════════════════════════════════ -->
  <!-- Aufbau nach dem Culture-Abschnitt von saltandpictures.de: Über dem
       Raster klebt der Abschnittsname als Riesenwort und wandert beim
       Scrollen über die Kacheln hinweg. Er invertiert dabei, was hinter
       ihm liegt — auf dem schwarzen Grund steht er weiß, über einem Bild
       kehrt er dessen Farbe um.

       Voll bis an den Seitenrand statt im Container: Das Wort braucht die
       Breite, und das Raster steht damit auf derselben Kante wie das Logo
       im Header. Deshalb --edge und kein --gutter. -->
  <section class="section work" id="arbeiten" aria-labelledby="work-title">
    <!-- Englisch wie der Positions-Satz im Hero, deshalb lang="en": Ohne
         die Angabe liest eine Sprachausgabe "Featured Work" deutsch vor. -->
    <h2 class="kapitelwort" id="work-title" lang="en">Featured Work</h2>

    <!-- Zwei Bildformate statt sechs: Die Filmprojekte stehen hochkant,
         die beiden Fotostrecken quer. Das ist keine Vereinheitlichung um
         der Ordnung willen, sondern folgt der Gattung — und es ist die
         Bedingung dafür, dass die versetzten Spalten überhaupt als Muster
         lesbar sind. Das echte Ausgabeformat steht in der Zeile darunter,
         es geht also nichts verloren. -->
    <div class="werke">
      {arbeiten.map((a) => (
        <article class="werk" style={`--r: ${a.art === 'Foto' ? '4 / 3' : '3 / 4'}`}>
          <a class="werk__link" href={withBase(`/arbeiten/${a.slug}`)} data-zeiger="View">
            <img src={withBase(a.bild)} alt={a.alt} width={a.breite} height={a.hoehe} loading="lazy" decoding="async" />
            <span class="werk__zeile">
              <span class="werk__pille">{a.art}</span>
              <!-- Die Ansage steht einmal vor der Klammer, nicht an jedem
                   Wert: "Formate 9:16 · 16:9" statt zweimal "Format". Der
                   Plural richtet sich nach der Anzahl. -->
              <span class="werk__formate">
                <span class="visually-hidden">
                  {a.formate.length > 1 ? 'Formate ' : 'Format '}
                </span>
                [{a.formate.join(' · ')}]
              </span>
            </span>
            <h3 class="werk__titel">{a.kunde}</h3>
            <p class="werk__projekt">{a.titel}</p>
          </a>
        </article>
      ))}
    </div>

    <!-- Die Kundenliste schließt das Kapitel ab. Sie stand bis zum
         7. August 2026 als eigener Abschnitt darunter — eine Leiste
         zwischen zwei Haarlinien, in der zwölf Logos endlos nach links
         liefen. Zwei Gründe, warum sie so nicht mehr passt:

         Die Leiste war die dritte Stelle mit derselben Geste. Der Akzent,
         der beim Überfahren von links durchläuft, trägt inzwischen die
         Services und die FAQ; an einem Logoband, das gar nichts aufklappt,
         versprach er etwas, das er nicht einlöst.

         Und sie lief. Auf einer Seite, deren einzige waagerechte Bewegung
         das klebende Kapitelwort ist, war eine Endlosschleife der einzige
         Punkt, an dem sich etwas von allein bewegte.

         Jetzt steht die Liste da, wo sie hingehört: unter den sechs
         Arbeiten, im selben Kapitel. Die Kacheln zeigen sechs Projekte,
         die Zeilen darunter nennen, für wen sonst noch. Das ist keine
         eigene Behauptung mehr, sondern die Fußnote zu den Arbeiten —
         deshalb kein Abschnitt, keine Überschrift und keine Fläche,
         sondern nur eine Marginalie und ein Raster aus Zeilen. -->
    <div class="kundschaft">
      <p class="label kundschaft__label">Ausgewählte Kunden</p>

      <ul class="kundschaft__raster">
        {kunden.map((k) => (
          <li class="kundschaft__feld">
            <a class="kundschaft__link" href={k.url} target="_blank" rel="noopener">
              <img
                src={withBase(`/images/kunden/${k.datei}.png`)}
                alt={k.name}
                width={k.b} height={k.h}
                loading="lazy" decoding="async"
                style={`--b: ${logoBreite(k)}`}
              />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 4 · SERVICES ═══════════════════════════════════════════════════ -->
  <section class="section section--sand services" aria-labelledby="services-title">
    <div class="container container--breit">
      <!-- Marginalienstil wie bei "Warum Le Werk", nicht die große
           Überschrift der übrigen Abschnitte. Steht als h2 und nicht als
           p — ohne Überschrift auf dieser Ebene bliebe eine Lücke in der
           Gliederung.

           Der Modifier --nur-marke ist Pflicht, nicht Geschmack: Die
           Grundabstände sind auf eine Headline gerechnet, unter einer
           12px-Zeile wirken 72px wie ein Loch.

           "Content, holistisch gedacht" stand hier früher als Headline,
           davor zusätzlich ein Fließtext, der die Disziplinen abstufte
           ("Hauptdisziplin", "klare Zweite"). Beides ist entfallen. -->
      <!-- Ein Wort, sonst nichts. "Was wir machen" stand hier als
           Marginalie darüber und ist entfallen — der Abschnitt heißt jetzt
           im Vorlesen wie im Menü und in der Fußzeile. -->
      <header class="sec-head sec-head--knapp" data-reveal>
        <h2 class="headline kapitel" id="services-title">Services</h2>
      </header>

      <!-- Eine Indexliste statt dreier Bildkacheln, übernommen aus
           Entwurf 04c-XII: Nummer, Name in voller Größe, und die
           Beschreibung klappt beim Überfahren auf. Der Akzent läuft dabei
           von links durch — dieselbe Geste wie an der Kundenleiste und an
           den FAQ-Zeilen.

           Damit fallen die drei Motive weg, die hier standen. Zwei davon
           waren ohnehin Platzhalter aus einer Bilddatenbank; auf einer
           Seite, die von der eigenen Bildsprache lebt, standen sie an
           genau der falschen Stelle.

           Workshops fehlen bewusst: keine Produktionsdisziplin, nur über
           Menü, Fußzeile und /services erreichbar. -->
      <ol class="dienste">
        {disziplinen.map((s, i) => (
          <li class="dienst">
            <span class="dienst__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="dienst__block">
              <h3 class="dienst__name">{s.titel ?? s.label}</h3>
              <!-- Das innere Element trägt das Kappen: Eine Höhe von 0 auf
                   die tatsächliche Texthöhe aufzuziehen braucht zwei
                   Kästen. Der Text steht immer im Markup und wird
                   vorgelesen — sichtbar wird er beim Überfahren. -->
              <div class="dienst__text"><p>{s.text}</p></div>
            </div>
            <span class="dienst__pfeil" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 5 · STUDIO ═════════════════════════════════════════════════════ -->
  <section class="section section--dark team" aria-labelledby="team-title">
    <!-- "Studio" klebt und wandert über die Gesichter und die Kulisse,
         genau wie "Featured Work" über die Arbeiten. Beide Abschnitte
         sind Bildfelder und bekommen deshalb dieselbe Behandlung; der
         Container entfällt, weil das Wort die volle Breite braucht. -->
    <h2 class="kapitelwort" id="team-title">Studio</h2>

      <!-- Erst die Gesichter … Name und Rolle stehen auf dem Bild, wie bei
           den Disziplinen weiter oben: Der Name ist immer da, die Rolle
           klappt beim Überfahren darunter auf und hebt ihn dabei an. -->
      <ul class="team__grid">
        {team.map((m, i) => (
          <li class="team__member" data-reveal data-reveal-delay={i * 70}>
            <figure class="team__bild">
              <img
                class="team__portrait"
                src={withBase(m.img)} alt={m.alt}
                width="700" height="700" loading="lazy" decoding="async"
              />
              <figcaption class="team__fuss">
                <span class="team__name">{m.name}</span>
                <span class="team__role">
                  <span>
                    {m.role.split('|').map((t) => (
                      <span class="team__zeile">{t.trim()}</span>
                    ))}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <!-- … dann die Kulisse: ein versetztes Feld aus Studio- und
           Set-Aufnahmen, in dem die beiden Sätze auf einem Bildplatz
           stehen statt daneben. Aufbau und Begründung im Frontmatter
           bei kulisseRoh.

           Die Aufnahmen sind keine Bildunterschriften zu den Sätzen,
           sondern eine eigene Reihe — deshalb ul mit eigenem Label und
           nicht figure. -->
      <ul class="kulisse" aria-label="Aus dem Studio und von unseren Sets">
        {kulisse.map((k) => (
          k.text ? (
            <li class="kulisse__satz" data-spalte={k.spalte}>
              <!-- Der Satz steht als Zeitungsspalte: Ressortzeile,
                   Schlagzeile, Fließtext mit Initial. Warum so und woher
                   die einzelnen Teile kommen, steht bei .notiz im CSS. -->
              <article class="notiz">
                <p class="notiz__ressort">{k.ressort}</p>
                <h3 class="notiz__titel">{k.vorspann}</h3>
                <p class="notiz__text">{k.satz}</p>
              </article>
            </li>
          ) : (
            <li class="kulisse__stueck" data-spalte={k.spalte} style={`--r: ${k.hoch ? '3 / 4' : '4 / 3'}`}>
              <img src={withBase(k.img)} alt={k.alt} loading="lazy" decoding="async" />
              <span class="kulisse__zeile">
                <span class="kulisse__pille">{k.pille}</span>
                <span class="kulisse__nr" aria-hidden="true">[{k.nr}]</span>
              </span>
              <p class="kulisse__titel">{k.titel}</p>
            </li>
          )
        ))}
      </ul>
  </section>

  <!-- ═══ 6 · DREI GRÜNDE ════════════════════════════════════════════════ -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container container--breit">
      <!-- Ohne große Überschrift: "Drei Gründe, uns anzurufen" ist
