          contact@lewerk.de
          <span class="weg__pfeil" aria-hidden="true">→</span>
        </a>
        <a class="weg" href="tel:+4922129256496">
          +49&nbsp;221&nbsp;29256496
          <span class="weg__pfeil" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Der Zeiger. Er ersetzt den Mauspfeil auf dieser Seite: eine kleine
       Scheibe, die dem Zeiger mit Nachlauf folgt, und die über den
       Arbeiten zu einer Fläche mit Beschriftung aufgeht.

       aria-hidden und ohne eigenen Inhalt in der Gliederung: Er zeigt
       nichts an, was nicht ohnehin dasteht — die Kacheln sind Links und
       als solche angekündigt. -->
  <div class="zeiger" aria-hidden="true"><span></span></div>

</BaseLayout>

<style>
  /* Der gemeinsame Sektionskopf .sec-head steht in global.css — er wird
     inzwischen auch von den Projektseiten gebraucht, und Astro-Styles
     gelten nur in der Datei, in der sie stehen. */

  /* ── 1 · Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    /* Der untere Wert setzt den Text über der Unterkante. Er ist zweimal
       gewachsen: 10vh ließen ihn 80px über dem Rand sitzen und damit fast
       auf dem Scroll-Pfeil, 13.5vh gaben 108px. Jetzt 17vh — der Satz
       steht deutlich über der Mitte der unteren Hälfte und lässt mehr
       Video frei. */
    padding-block: clamp(8rem, 18vh, 12rem) clamp(6.5rem, 17vh, 11.5rem);
    background: var(--petrol-deep);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ohne jeden Filter. Er lag zuletzt bei brightness(0.92), davor bei
       0.82 — beides nahm dem Material Licht, das es nicht hergeben muss.
       Die Lesbarkeit trägt allein der Verlauf darunter, und der sitzt da,
       wo die Schrift steht, statt über dem ganzen Bild. Nebenbei fällt
       damit eine Filterebene über einem formatfüllenden Video weg. */
  }

  .hero__media::after { content: ''; position: absolute; inset: 0; }

  /* Lesbarkeitsverlauf in neutralem Schwarz statt in Petrol: Ein farbiger
     Verlauf legt sich als Stich über das ganze Material und verfälscht die
     Farben der Aufnahme. Schwarz dunkelt ab, ohne einzufärben.
     Die Werte sind über mehrere Videoframes gemessen, nicht geschätzt.

     Zweimal zurückgenommen, damit mehr vom Video zu sehen ist. Der Fuß
     lief 0.90 → 0.82 → 0.72, die obere Kante 0.40 → 0.24 → 0.14, die
     Mitte ist inzwischen ganz offen. Der Verlauf sitzt nur noch dort, wo
     die Schrift steht. */
  .hero__media::after {
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.32) 24%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.14) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.1) 42%, rgba(0, 0, 0, 0) 64%);
  }

  /* Auf schmalen Schirmen steht der Satz sechszeilig statt zweizeilig und
     reicht damit bis auf 35 % der Höhe hinauf — dort war der Verlauf schon
     fast offen und der Kontrast fiel auf 2.8:1. Der Verlauf greift hier
     deshalb höher. Der seitliche fällt weg: Der Satz nimmt die volle
     Breite ein, eine linke Kante gibt es nicht mehr abzudunkeln. */
  @media (max-width: 1023.98px) {
    .hero__media::after {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.46) 30%, rgba(0, 0, 0, 0.1) 55%, rgba(0, 0, 0, 0) 72%, rgba(0, 0, 0, 0.12) 100%);
    }
  }

  /* Randabstand wie im Header, damit Text und Logo auf einer Achse sitzen */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--edge);
  }

  /* Seit dem 6. August 2026 komplett Poppins: Die Wortmarke bleibt
     ExtraBold (.brand, unverändert), der Satz selbst läuft im
     Medium-Schnitt mit — die Bodoni-Fassung ist verworfen. 500 und nicht
     400, weil der Satz auf bewegtem Video steht und Regular dort zu dünn
     auftrat. Maße aus Entwurf 04c-XII übernommen. */
  .hero__statement {
    max-width: 44ch;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.2vw, 2.875rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--on-dark);
    text-wrap: pretty;
  }

  /* Ohne die Serifenrolle entfällt auch das Kursiv — "worth watching."
     läuft im Satz mit. Das em bleibt im Markup: Die Betonung gilt, sie
     ist nur nicht mehr sichtbar. */
  .hero__statement em { font-style: normal; }

  /* Beide blenden beim Scrollen aus — das Skript am Ende der Datei
     schreibt Deckkraft und Weg. will-change, weil es an jedem Bild
     geschieht. */
  .hero__statement,
  .hero__cue { will-change: opacity, transform; }

  /* Die beiden Satzhälften. Sie tragen den Umbruch — der steckt damit in
     der Struktur statt in einem <br>, das unter 820px wieder weg müsste. */
  .hero__zeile { display: block; }

  /* DER AUFTRITT, LEISE FASSUNG. Vorher stieg jede Hälfte über ihre
     volle Höhe aus einer Maske herauf: ein Vorspann, wirkungsvoll, aber
     laut — die Bewegung war das Erste, was man sah, und erst danach der
     Satz.

     Jetzt ein kurzer Weg und eine Blende: 0,4 Geviert von unten, dazu
     von durchsichtig auf deckend, über 1400ms. Der Weg ist damit rund
     18px statt 63 — man sieht, dass der Satz ankommt, aber nicht, wie
     weit er gereist ist.

     Länger und weicher zugleich: Die Kurve setzt fast ohne Anfahrt ein
     und läuft lang aus. Der Versatz zwischen den Hälften ist von 130 auf
     200ms gewachsen — bei einer kleinen Bewegung braucht es mehr
     Abstand, damit man sie überhaupt als zwei liest.

     Ohne Maske: Bei diesem Weg gäbe es nichts zu verbergen, und der
     Fußabstand, den eine Maske für die Unterlängen braucht, fällt mit
     weg. */
  .hero__zeile > span {
    display: block;
    opacity: 0;
    transform: translateY(0.4em);
    animation: buehne-auf 1400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(320ms + var(--zeile, 0) * 200ms);
  }

  @keyframes buehne-auf {
    to { opacity: 1; transform: none; }
  }

  /* Das Bild setzt sich — ebenfalls zurückgenommen: drei statt sechs
     Prozent, dafür über zweieinhalb Sekunden. Die Bewegung ist damit
     kaum noch zu benennen und trotzdem zu spüren; genau das war
     gemeint.

     both, damit der Anfangswert schon vor dem ersten Bild gilt und das
     Video nicht kurz in voller Größe aufblitzt. */
  .hero__media video {
    animation: buehne-setzen 2500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes buehne-setzen {
    from { transform: scale(1.03); }
    to   { transform: scale(1); }
  }


  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 6vh, 3.5rem);
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    animation: cue 2.4s var(--ease-out) infinite,
               buehne-blende 700ms var(--ease-out) 1500ms backwards;
  }

  /* NUR DER WEG, KEINE DECKKRAFT. Die Deckkraft stand hier mit drin und
     hat das Ausblenden beim Scrollen unbrauchbar gemacht: Eine laufende
     Animation schlägt in der Rangfolge jeden Stilwert am Element, also
     auch den, den das Skript schreibt. Der Pfeil pulsierte weiter bei
     0.75, während im Stilwert längst 0 stand — im Browser nachgemessen.

     Jetzt trägt die Animation nur den Weg, die Deckkraft gehört dem
     Skript. Der Auftritt beim Laden läuft als zweite Animation daneben
     und mit backwards statt forwards: Sie hält den Anfangswert vor ihrem
     Beginn, gibt die Eigenschaft danach aber wieder frei. */
  @keyframes cue {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(6px); }
  }

  @keyframes buehne-blende {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── 2 · Positionierung ───────────────────────────────────────────────── */
  .statement { padding-block: clamp(4.5rem, 10vw, 8.5rem); }

  /* Linksbündig statt zentriert — der Absatz beginnt auf derselben Kante
     wie Logo und Hero-Satz. Bis 1440px ist das exakt --edge; darüber
     wandert der zentrierte Container mit, die Kante bleibt aber die
     linkeste der Seite. Übernommen aus Entwurf 04c-XII. */
  .statement__inner { text-align: left; }

  /* Poppins Medium in Blau statt Bodoni in Tinte — Satzbild nach
     salt & pictures, Maße aus Entwurf 04c-XII: 60px bei 1440er Fenster,
     Durchschuss 1.1, der Block läuft fast über die volle Seitenbreite.
     Der negative Rand zieht ihn aus dem Container auf die --edge-Kante
     von Logo und Hero-Satz; unter 1440px sind beide Ränder gleich groß
     und der Rand damit null oder kleiner. */
  .statement__text {
    max-width: none;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: clamp(1.5rem, 4.35vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--akzent);
    /* In dieser Größe ist eine Silbentrennung deutlich sichtbar und wirkt
       wie ein Fehler — der Satz darf lieber eine Zeile länger werden. */
    hyphens: none;
  }

  /* Auftakt und Schluss laufen aufrecht mit — die em bleiben als
     Betonung im Markup, sichtbar kursiv sind nur die drei Disziplinen. */
  .statement__text em { font-style: normal; }

  /* Die drei Disziplinen als kursive Bodoni-Einlage, wie bei
     salt & pictures: eine Spur größer, damit die Serife gegen das
     Grotesk drumherum nicht abfällt. */
  .statement__kursiv {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 500;
    font-size: 1.05em;
    letter-spacing: 0;
  }

  /* Die Leistung am Satzende — die Stelle, an der der Absatz sagt, was
     Le Werk macht. Sie trägt jetzt nur noch Gewicht.

     DER STRICH IST WEG. Er stand hier zwei Anläufe lang: ein geschwungener
     Federstrich in Bernstein, als SVG im Hintergrund, der beim Scrollen von
     links heranwuchs. Seine Form und die Rechnung dazu stehen in der
     Git-Historie (Stand 50bfbfc). Dafür geht die Phrase eine Stufe hoch:

       vorher   600 für die Phrase, 800 für "Social"
       jetzt    800 für beides

     800 IST HIER DIE DECKE. Poppins liegt lokal in 400, 500, 600 und 800
     vor (src/styles/fonts/) — 900 gibt es bei Poppins, sie ist nur nicht
     eingebunden. "Social" kann also nicht weiter vor die übrige Phrase
     treten; wer das will, braucht eine weitere Schriftdatei.

     Der Absatz selbst läuft in 500. Drei Stufen Unterschied auf 46px sind
     deutlich zu sehen, und die Phrase ist damit das Schwerste im Absatz —
     zusammen mit der Wortmarke, die dasselbe Gewicht trägt. */
  .statement__leistung { font-weight: 800; }

  /* Ohne Wirkung, solange 800 die schwerste eingebundene Poppins ist —
     bolder von 800 aus wählt der Browser ohnehin wieder 800. Die
     Auszeichnung bleibt trotzdem im Markup: Sie ist die Aussage "vor
     allem das Social", eine Sprachausgabe betont sie, und käme je eine
     900 dazu, greift die Regel von selbst. */
  .statement__leistung strong { font-weight: 800; }

  /* Die Phrase färbt sich stufenlos auf, statt wie die übrigen Wörter in
     einem Schritt umzuspringen. Den Grad dafür schreibt das Skript am Ende
     der Datei als --auf; seit der Strich weg ist, ist die Farbe das
     Einzige, was daran hängt. Beide Wähler, weil das Skript den Wörtern
     unterwegs .is-an anhängt und dessen Regel sonst gewinnt. */
  .statement__leistung :global(.wort),
  .statement__leistung :global(.wort.is-an) {
    color: color-mix(in srgb, var(--akzent) calc(20% + 80% * var(--auf, 1)), transparent);
    transition: none;
  }

  /* Mit Skript beginnt beides bei null. Ohne Skript bleibt --auf auf 1,
     und der Satz steht vollständig da — dieselbe Bauart wie bei der
     Meta-Zeile darunter. */
  @media (scripting: enabled) {
    .statement__leistung { --auf: 0; }
  }

  /* Die Wörter erzeugt das Skript am Ende der Datei — deshalb :global,
     Astros Geltungsstempel bekämen sie sonst nie. Sie stehen von Anfang
     an, nur auf ein Fünftel der Deckung gedimmt, und färben sich beim
     Scrollen der Reihe nach auf das volle Blau. */
  .statement__text :global(.wort) {
    color: color-mix(in srgb, var(--akzent) 20%, transparent);
    transition: color 450ms var(--ease-out);
  }

  .statement__text :global(.wort.is-an) { color: var(--akzent); }

  /* Gesperrte Versalzeile als Gegengewicht — auf derselben Kante wie der
     Absatz. Sie blendet erst ein, wenn der Absatz weitgehend aufgefärbt
     ist; die Deckung schreibt das Skript. Der Startwert 0 gilt nur mit
     Skript — ohne bleibt die Zeile sichtbar. */
  .statement__meta {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  @media (scripting: enabled) {
    .statement__meta { opacity: 0; }
  }

  /* ── 3 · Schwarzwechsel ───────────────────────────────────────────────── */
  /* Ab "Featured Work" läuft die Startseite auf Schwarz — eine Fläche
     für alles darunter, wie in Entwurf 04c-XII abgenommen. Die Sektionen
     behalten ihre Klassen (--dark, --sand); überschrieben werden nur die
     Token, damit Labels, Linien und Fließtexte überall mitwechseln.
     .section davor, weil .section--sand sonst gleichrangig wäre und die
     Reihenfolge im Bündel entschiede. */
  .section.work,
  .section.services,
  .section.team,
  .section.benefits,
  .section.faq,
  .section.cta {
    background: #0d0d0d;
    color: #fff;
    --ink: #fff;
    --ink-muted: rgba(255, 255, 255, 0.65);
    --on-dark: #fff;
    --on-dark-muted: rgba(255, 255, 255, 0.65);
    --line: rgba(255, 255, 255, 0.15);
    --line-strong: rgba(255, 255, 255, 0.3);
    --line-dark: rgba(255, 255, 255, 0.15);
    /* Die Marken-Akzente im Inneren — Ziffern der Gründe, das Plus im FAQ —
       greifen auf --petrol zu. Im schwarzen Teil steht dort der Akzent
       aus dem Positionsabsatz, damit die Seite eine Akzentfarbe hat und
       nicht zwei.

       Petrol selbst ginge hier ohnehin nicht: #006377 käme auf #0d0d0d
       auf 1.9:1. Die helle Schwester stand bei 9.4, der Akzent steht bei
       3.00 — die Ziffern verlieren dadurch an Auffälligkeit. Sie sind
       aria-hidden und Schmuck, und das Plus im FAQ ist ein
       Bedienelement, für die gilt 3.0. Details am Token in global.css. */
    --petrol: var(--akzent-hell);
  }

  /* Petrol als Fokusfarbe ist auf Schwarz nicht mehr zu sehen (1.6:1) —
     im schwarzen Teil zeichnet Weiß den Ring. */
  .section.work :focus-visible,
  .section.services :focus-visible,
  .section.team :focus-visible,
  .section.benefits :focus-visible,
  .section.faq :focus-visible,
  .section.cta :focus-visible { outline-color: #fff; }

  /* Hier stand die Regel für den bernsteinfarbenen Knopf "Projekt
     anfragen". Der Abschluss trägt keine Knöpfe mehr, sondern drei große
     Zeilen mit Pfeil — siehe .wege weiter unten. */

  /* Der Footer liegt eine Stufe tiefer als die Abschnitte — dieselbe
     Logik wie vorher Petrol-Deep zu Petrol-Deeper. Er steht im Layout,
     deshalb :global; die Regel lädt nur mit der Startseite. */
  :global(.footer) { background: #070707; }

  /* Alle Bilder eckig: Der Token gilt für Kacheln, Porträts und
     Haufenstücke gleichermaßen — auf body gesetzt, damit auch der
     Streublock ihn erbt. Knöpfe und Pillen behalten ihre Form. */
  :global(body) { --radius-bild: 0px; }

  /* Der feste Header folgt dem Schnitt: Sobald "Featured Work" unter ihm
     ansteht, wird die solide Fläche schwarz statt weiß — die Klasse
     setzt das Skript am Ende der Datei. Dreifach, um die is-solid-Regeln
     aus global.css sicher zu schlagen. */
  :global(.header.is-solid.is-dunkel) {
    background: rgba(13, 13, 13, 0.94);
    color: #fff;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.15);
  }



  /* ── 4 · Featured Work ────────────────────────────────────────────────── */
  /* Nach dem Culture-Abschnitt von saltandpictures.de. Die frühere
     Fassung — ein Reißverschluss aus drei Paaren im Zwölfspaltigen, jede
     Kachel in ihrem eigenen Format, Kundenname im Bild, Kacheln laufen
     beim Scrollen seitlich auf ihren Platz zu — ist damit vollständig
     abgelöst. Die Maße dieser Anordnung stehen in der Git-Historie.

     Voll bis an den Seitenrand: Das Raster steht auf --edge, derselben
     Kante wie Logo und Hero-Satz, statt im 1440er Container. */
  .work {
    padding-block: clamp(4rem, 12vh, 9rem) clamp(3.5rem, 10vh, 8rem);
    padding-inline: var(--edge);
  }

  /* Das Riesenwort klebt oben und wandert beim Scrollen über die Kacheln.

     mix-blend-mode: difference macht die Umkehrung: Auf dem schwarzen
     Grund (13,13,13) bleibt Weiß praktisch Weiß, über einem Bild kehrt
     es dessen Farbe um. Ein weißes Wort mit Schatten täte das nicht — es
     würde über hellen Bildstellen schlicht verschwinden.

     pointer-events: none ist Bedingung, nicht Kosmetik: Das Wort liegt
     über den Kacheln und würde deren Links sonst abfangen.

     Der negative Fußabstand zieht das Raster unter das Wort. Ohne ihn
     stünde eine Zeilenhöhe Leerraum dazwischen, und der Kleber liefe ins
     Nichts.

     GRÖSSE: 10,7vw und nicht die 15,5vw der Vorlage. Dort steht ein Wort
     mit sieben Zeichen, hier sind es dreizehn. Im Browser nachgemessen
     misst "FEATURED WORK" in Poppins ExtraBold bei −0.035em Laufweite
     8,109 Geviert; die größte Schrift, die zwischen die beiden Ränder
     passt, ist also (100vw − 2 × --edge) / 8,109. Ausgerechnet über die
     Fensterbreiten:

       320px   10,79vw      1440px   11,71vw
       375     11,02        1920     11,82
       768     11,69        2560     11,95

     Das schmalste Fenster setzt die Grenze. 10,7vw liegt darunter und
     füllt oben 91 Prozent der freien Breite — voll genug, dass das Wort
     die Seite trägt, mit Luft genug, dass es nicht klemmt.

     Die Untergrenze steht bei 1,25rem und nicht höher: rem hängt an der
     Grundschrift des Browsers, und bei 20px statt 16 wären aus 1,75rem
     35px geworden — genau der Wert, der bei 320px Fenster gerade noch
     passt. Kein Spielraum.

     KLEBEHÖHE: unter dem Kopf, nicht darunter hindurch. Bei 4vh — dem
     Wert der Vorlage — stand das Wort 36px unter der Fensterkante,
     während der feste Kopf 96px hoch ist: 60 der 123px Worthöhe waren
     verdeckt, also fast die Hälfte. Die Vorlage hat keinen mitlaufenden
     Kopf und kann sich das leisten.

     Jetzt --kopf-hoehe plus ein Abstand. Der Wert hängt an derselben
     Polsterung wie der Kopf selbst — wer den Kopf ändert, zieht das Wort
     mit. */
  .kapitelwort {
    position: sticky;
    top: calc(var(--kopf-hoehe) + var(--space-2));
    z-index: 2;
    pointer-events: none;
    margin-bottom: -0.35em;
    text-align: center;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: var(--fs-kapitel);
    line-height: 0.8;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: nowrap;
    color: #fff;
    mix-blend-mode: difference;
  }

  /* Drei Spalten für sechs Projekte — zwei volle Reihen. Die Vorlage
     steht auf vier Spalten, hat dort aber acht Kacheln; vier Spalten
     ließen hier die zweite Reihe halb leer stehen. */
  .werke {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  /* Der Versatz je Spalte ist das, was das Raster zum Muster macht. Er
     läuft als Zickzack: links oben, in der Mitte tief hinunter, rechts
     wieder ein Stück herauf. Beide Reihen folgen ihm, dadurch
     überschneiden sie sich, und das Riesenwort läuft nie über eine
     gerade Kante.

       Spalte 1     0        Siemens        Street One
       Spalte 2    18vh      Revitive       Formel D
       Spalte 3     7vh      Allianz        BVB

     margin-top und nicht transform: Die Kachel soll den Platz, den sie
     einnimmt, auch beanspruchen — sonst liefe die Reihe darunter hinein.

     In vh und nicht in vw, wie in der Vorlage: Der Versatz ist ein Weg
     beim Scrollen, kein Maß der Fläche.

     IN DER MITTE STEHT JEWEILS EINE FOTOSTRECKE, und das gehört zum
     Versatz. Die beiden Strecken sind quer aufgenommen und damit die
     kürzesten Kacheln — 324px gegen 576 der Hochformate. Eine Reihe ist
     so hoch wie ihre höchste Kachel; ohne Versatz klaffte unter der
     kurzen der ganze Rest der Reihe. Hängt sie dagegen tief, steht die
     Lücke über ihr und ist der Versatz selbst. Gemessen bei 1440 x 900
     liegen dann 162px über und 153 unter ihr.

     Wer in arbeiten.ts umsortiert, muss das mitdenken — die Regel steht
     dort im Kopf der Datei. */
  .werk {
    align-self: start;
    margin-top: var(--rutsch, 0);
  }

  .werk:nth-child(3n + 2) { --rutsch: 18vh; }
  .werk:nth-child(3n) { --rutsch: 7vh; }

  .werk__link {
    display: grid;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  /* Graustufen, Farbe erst beim Überfahren — wie in der Vorlage und wie
     bei Disziplinen und Porträts weiter unten. Der leichte Kontrastzug
     fängt auf, was Graustufen an Trennung kosten.

     Kein Verlauf und keine zweite Ebene mehr über dem Bild: Seit dem
     6. August 2026 steht das Motiv frei, es liegt keine Schrift mehr
     darauf, die einen Lesbarkeitsverlauf bräuchte. */
  /* Farbig von Anfang an. Die Graustufen standen hier, um sechs
     Aufnahmen aus sechs Produktionen zu einer Reihe zu binden — bei
     eigenen Arbeiten ist aber genau das Gegenteil richtig: Sie sollen
     zeigen, was sie sind. Die Reihe hält jetzt das Raster zusammen,
     nicht die Entfärbung. */
  .werk__link img {
    width: 100%;
    aspect-ratio: var(--r, 3 / 4);
    object-fit: cover;
  }

  /* Gattung links, Ausgabeformate rechts. In 12px und nicht in rem: Die
     Zeile ist die kleinste Schrift der Seite und soll auf jedem Gerät
     dieselbe Größe haben wie in der Vorlage.

     Umbrechen darf sie: Beide Teile stehen auf nowrap, und "Formate
     [9:16 · 16:9]" braucht neben der Pille zusammen 145px. Unterhalb von
     rund 350px Fenster misst die Kachel weniger — gemessen 132px bei
     320 —, und die Zeile lief in den Spaltenabstand hinaus. Mit Umbruch
     rutschen die Formate unter die Pille. Oberhalb greift das nie. */
  .werk__zeile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 0.75rem;
    font-size: 12px;
    line-height: 1.5;
  }

  /* Alle Pillen gleich: eine Kontur in der Textfarbe. Die beiden
     Fotostrecken trugen hier eine blau gefüllte Pille und waren damit als
     Ausnahme markiert — die Gattung steht aber ohnehin lesbar darin, die
     Füllung hat nur eine zweite Aussage darüber gelegt. */
  .werk__pille {
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: background-color 250ms var(--ease-out),
                border-color 250ms var(--ease-out),
                color 250ms var(--ease-out);
  }

  /* Die Pille selbst ist das Ziel, nicht die Kachel: Sie färbt sich nur,
     wenn der Zeiger wirklich auf ihr steht. Über der Kachel zu sein
     genügt nicht — sonst leuchtete sie schon auf, während man das Bild
     ansieht.

     Schwarz auf Bernstein und nicht Weiß: #0d0d0d steht auf #FFB300 bei
     10.83:1, Weiß nur bei 1.79 — auf dem hellen Gelb wäre die
     Beschriftung schlicht weg. */
  /* DIE PILLE LEGT SICH ÜBER DEN ZEIGER, und das ist die Bedingung dafür,
     dass sie überhaupt bernsteinfarben aussieht.

     Der Zeiger ist eine weiße Scheibe mit mix-blend-mode: difference — er
     kehrt um, was unter ihm liegt. #FFB300 umgekehrt ist
     rgb(255-255, 255-179, 255-0), also rgb(0, 76, 255), und das ist auf
     drei Stellen genau --akzent. Die Pille sah unter der Scheibe deshalb
     exakt so blau aus wie die Füllung, die sie ersetzt hat — und sie war
     nie anders zu sehen, weil man beim Überfahren zwangsläufig die
     Scheibe darauf hat.

     Die Farbe umzudrehen wäre der naheliegende Trick und geht schief: Die
     Pille misst 50 x 24px, ihre Diagonale 55, die Scheibe hat aber nur
     46px Radius. Steht der Zeiger am Rand der Pille, ragt ihr anderes
     Ende aus der Scheibe heraus — dort stünde dann das echte Blau. Am
     Bild geprüft, der Streifen ist deutlich zu sehen.

     Also andersherum: Die Pille wird über die Scheibe gehoben. Dann ist
     Bernstein Bernstein, an jeder Stelle, und die Scheibe bekommt ein
     pillenförmiges Loch.

     Nur im Hover-Zustand, nicht dauerhaft: Ein z-index über der
     Zeigerebene liegt auch über dem festen Kopf, und eine Pille, die beim
     Scrollen durch die Kopfleiste wandert, wäre schlimmer als das
     Problem. Wer sie überfährt, hat sie ohnehin nicht unter dem Kopf. */
  .werk__pille:hover {
    position: relative;
    z-index: calc(var(--z-overlay) + 200);
    background: var(--marke);
    border-color: var(--marke);
    color: #0d0d0d;
  }

  @media (prefers-reduced-motion: reduce) {
    .werk__pille { transition: none; }
  }

  .werk__formate {
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--ink-muted);
  }

  /* Der Kunde trägt die Kachel und steht deshalb in der Redaktionsschrift
     — dieselbe Rolle wie der Kampagnentitel in der Vorlage. Versal und
     leicht gesperrt, weil Bodoni in Versalien sonst zu eng läuft. */
  .werk__titel {
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Was für den Kunden entstanden ist. Steht unter dem Namen und im
     selben Ton wie die Zeile über dem Bild, damit die Kachel oben und
     unten von derselben kleinen Schrift eingefasst wird. */
  .werk__projekt {
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Zwei Spalten und ohne Versatz, sobald die Kachel unter etwa 270px
     fällt. Der Versatz braucht Reihen, die breit genug sind, um sich zu
     überschneiden; zu zweit läse er sich als verrutschte Kachel — und
     bei zwei Spalten zählt 3n ohnehin nicht mehr die Spalten ab.

     Beide Wähler noch einmal, nicht nur .werk: :nth-child zählt in der
     Spezifität wie eine zweite Klasse und gewinnt gegen .werk, egal in
     welcher Medienabfrage es steht. Genau das ist hier zuerst passiert —
     der Versatz stand bei 375px Fenster weiter bei 146px. */
  @media (max-width: 859.98px) {
    .werke { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .werk:nth-child(3n + 2),
    .werk:nth-child(3n) { --rutsch: 0; }
  }

  /* ── Die Kundschaft ───────────────────────────────────────────────────── */
  /* Zwölf Logos als Feld unter den sechs Arbeiten, jedes in einem großen
     Kasten, der sich beim Überfahren mit Bernstein füllt.

     DIE GESTE IST DIE DER SEITE. Services und FAQ füllen sich beim
     Überfahren von links mit derselben Farbe, und dasselbe passiert hier —
     nur waagerecht in einem Kasten statt in einer Zeile. Damit ist die
     Kundschaft kein Fremdkörper mehr, sondern die dritte Stelle, an der
     Bernstein sagt: Hier kann man hinfassen. Jedes Logo führt auf die
     Seite des Unternehmens, das Versprechen wird also eingelöst.

     UND SIE NUTZT AUS, DASS DIE DATEIEN SCHWARZ SIND. Auf dem schwarzen
     Grund kehrt ein Filter sie auf Weiß um; läuft der Bernstein darunter,
     wird der Filter zurückgenommen und die Marke steht wieder schwarz da —
     bei 10.83:1. Kein zweites Bild, kein Umfärben, nur der Filter aus.

     GROSS UND NICHT KLEIN. Zuvor standen die Logos in sechs Spalten, auf
     zwei Dritteln Deckung, als Fußnote. Auf einer Seite, deren
     Kapitelwörter 154px hoch sind, war das der einzige Ort, der geflüstert
     hat. Vier Spalten statt sechs, volle Deckung, und der Kasten hat Luft:
     Die Marken stehen jetzt so groß da wie alles andere hier auch.

     ZWEI LINIEN, NICHT ZWÖLF. Das Feld ist oben und unten von einer
     Haarlinie eingefasst, dazwischen steht keine — die Kästen zeigen sich
     erst, wenn man sie anfasst. */
  .kundschaft { margin-top: clamp(4rem, 8vw, 7rem); }

  .kundschaft__label { margin-bottom: var(--space-3); }

  .kundschaft__raster {
    /* Der Kasten, in dem ein Logo steht. Die Breite je Marke hängt als
       Faktor --b daran; er wird im Frontmatter aus den Maßen der Datei
       gerechnet: Breite Wortmarken bekommen die volle Kastenbreite, hohe
       Bildmarken so viel, wie ihre Höhe zulässt. Auf gleiche Höhe
       gebracht wären die Wortmarken dreimal so schwer wie die
       Bildmarken.

       FESTE SPALTENZAHL, kein auto-fill: Zwölf gehen glatt in vier, drei
       und zwei auf; mit auto-fill stünde je nach Fensterbreite eine Reihe
       mit einer einzelnen Marke da. */
    --logo-breite: clamp(5.5rem, 11.5vw, 10.5rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--line);
  }

  .kundschaft__feld {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .kundschaft__feld::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 0;
    background: var(--marke);
    transition: width 350ms var(--ease-out);
  }

  .kundschaft__feld:hover::before,
  .kundschaft__feld:focus-within::before { width: 100%; }

  /* Die Höhe des Bildkastens steht fest und kommt nicht vom Bild. Das ist
     keine Kosmetik, sondern die Bedingung dafür, dass die Logos überhaupt
     erscheinen: Ein Bild mit loading="lazy" wird geladen, sobald sein
     Kasten in die Nähe des Sichtfelds kommt. Stehen Breite und Höhe auf
     auto, hat es vor dem Laden keine Größe — und was keine Größe hat,
     kommt nie in die Nähe des Sichtfelds. Genau das ist an der früheren
     Leiste einmal passiert, sie blieb leer.

     position: relative hebt den Link über die Fläche; ohne das deckte sie
     ihn zu. */
  .kundschaft__link {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    height: calc(var(--logo-breite) / 2.35);
    /* Waagerecht dieselbe Polsterung wie an den Dienstzeilen: Dort rückt
       der Inhalt um bis zu 20px von der Kante ein, die Fläche läuft aber
       bis an sie heran. Damit stehen die Logos auf derselben Kante wie
       die Ziffern der Services darunter. */
    padding: clamp(1.25rem, 2.6vw, 2.25rem) clamp(10px, 1.5vw, 20px);
    box-sizing: content-box;
  }

  .kundschaft__link:focus-visible { outline-offset: -6px; }

  /* invert(0) und nicht none als Zielwert: Zwischen zwei Filtern derselben
     Art rechnet der Browser weich durch, von einem Filter auf none
     springt er. */
  .kundschaft__link img {
    width: calc(var(--b, 1) * var(--logo-breite));
    height: auto;
    filter: invert(1);
    transition: filter 300ms var(--ease-out);
  }

  .kundschaft__feld:hover img,
  .kundschaft__feld:focus-within img { filter: invert(0); }

  @media (prefers-reduced-motion: reduce) {
    .kundschaft__feld::before,
    .kundschaft__link img { transition: none; }
  }

  @media (max-width: 859.98px) {
    .kundschaft__raster { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 559.98px) {
    .kundschaft__raster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ── Die Kapitelwörter ──────────────────────────────────────────────── */
  /* "Services" und "Studio" stehen in derselben Größe wie das klebende
     "Featured Work" darüber — 154px bei 1440er Fenster statt der 60px
     einer gewöhnlichen Überschrift.

     Gleiche Größe heißt nicht gleiche Breite, und das ist der Punkt: Bei
     10,7vw misst das längste Wort 1250px und füllt die Zeile, "Services"
     kommt auf 687 und "Studio" auf 542. Die drei Kapitel stehen also in
     einer Reihe und sind trotzdem auf den ersten Blick zu unterscheiden
     — die Länge des Wortes ist die Gliederung. Übernommen aus
     Entwurf 04c-XII.

     Der Deckel von .sec-head fällt hier weg: 46rem sind bei 16px
     Grundschrift 736px, und "SERVICES" stünde damit knapp davor —
     bei einer anderen Ersatzschrift aber dahinter und würde umbrechen.

     nowrap, weil ein Kapitelwort nie in zwei Zeilen fällt. */
  .kapitel {
    font-size: var(--fs-kapitel);
    line-height: 0.85;
    text-wrap: nowrap;
  }

  .sec-head--knapp { max-width: none; }

  /* ── 5 · Services ─────────────────────────────────────────────────────── */
  /* Eine Indexliste nach Entwurf 04c-XII. Die frühere Fassung — drei
     Bildkacheln im Zwölfspaltigen, Name und Text im unteren Band, zwei
     gemessene Lesbarkeitsverläufe darüber, dazu die seitliche
     Scrollbewegung — ist damit abgelöst. Ihre Maße stehen in der
     Git-Historie.

     Die Zeile ist derselbe Griff wie an der Kundenleiste und an den
     FAQ-Zeilen: Der Akzent läuft von links durch, die Zeile rückt ein.
     Dreimal dieselbe Geste auf einer Seite ist keine Wiederholung,
     sondern eine Sprache. */
  .dienste {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Drei Spalten: Nummer, Block, Pfeil. Die Nummernspalte wächst mit,
     bleibt aber zwischen 44 und 80px — schmaler trägt die Ziffer nicht,
     breiter reißt sie vom Namen ab.

     overflow: hidden ist Bedingung: Ohne es liefe die wachsende Fläche
     über die Zeile hinaus. Und .dienst > * braucht position, sonst läge
     sie über Ziffer, Name und Text statt darunter.

     cursor: default und nicht pointer: Die drei Disziplinen führen
     nirgendwohin — es gibt zu ihnen keine Unterseiten im Abschnitt. Der
     Pfeil ist eine Geste, kein Versprechen. */
  .dienst {
    position: relative;
    display: grid;
    grid-template-columns: minmax(44px, 80px) 1fr auto;
    gap: clamp(16px, 3vw, 48px);
    align-items: start;
    padding: clamp(22px, 3.4vw, 42px) clamp(10px, 1.5vw, 20px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    transition: padding-left 350ms var(--ease-out);
  }

  .dienst:first-child { border-top: 1px solid var(--line); }

  /* DIE FLÄCHE IST BERNSTEIN, NICHT BLAU. Damit trennt die Seite zwei
     Rollen sauber: Blau gehört dem, was man liest — der Positionsabsatz
     oben —, Bernstein dem, was man anfassen kann. Das sind die Pillen an
     den Kacheln, diese Zeilen hier und die FAQ. Wer über eine Zeile fährt,
     bekommt immer dieselbe Farbe zurück.

     Der Wechsel dreht die Zeile um: Auf #FFB300 steht Weiß bei 1.79:1 und
     wäre praktisch weg, #0d0d0d steht bei 10.83. Ziffer, Name, Text und
     Pfeil gehen deshalb beim Überfahren auf Schwarz — die Zeile liest sich
     dann wie mit dem Textmarker gezogen. */
  .dienst::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 0;
    background: var(--marke);
    transition: width 350ms var(--ease-out);
  }

  .dienst:hover::before { width: 100%; }
  .dienst:hover { padding-left: clamp(24px, 3vw, 44px); }
  .dienst > * { position: relative; }

  /* Die Ziffer in der Redaktionsschrift, kursiv — wie die Nummern der
     Gründe und der FAQ-Zeilen. line-height 2.2, damit sie auf der
     Grundlinie des Namens sitzt und nicht an dessen Oberkante. */
  .dienst__nr {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(15px, 1.6vw, 20px);
    line-height: 2.2;
    color: var(--ink-muted);
    transition: color 350ms var(--ease-out);
  }

  .dienst:hover .dienst__nr { color: #0d0d0d; }

  .dienst__name {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(28px, 5vw, 64px);
    line-height: 1;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: #fff;
    transition: color 350ms var(--ease-out);
  }

  .dienst:hover .dienst__name { color: #0d0d0d; }

  /* 0fr auf 1fr statt max-height: Damit läuft die Bewegung genau bis zur
     tatsächlichen Texthöhe, ohne dass irgendwo ein Maximalwert gepflegt
     werden müsste. */
  .dienst__text {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    transition: grid-template-rows 500ms var(--ease-out),
                margin-top 500ms var(--ease-out);
  }

  /* Weiß ist der Wert ohne Zeigegerät (siehe hover: none weiter unten) —
     dort steht der Text auf Schwarz. Mit Zeigegerät erscheint er nur auf
     der bernsteinfarbenen Fläche und geht dort auf Schwarz. */
  .dienst__text p {
    overflow: hidden;
    max-width: 56ch;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.84);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 400ms var(--ease-out) 80ms,
                transform 500ms var(--ease-out) 80ms;
  }

  .dienst:hover .dienst__text { grid-template-rows: 1fr; margin-top: 0.8em; }
  .dienst:hover .dienst__text p {
    opacity: 1;
    transform: none;
    color: rgba(13, 13, 13, 0.86);
  }

  /* Der Pfeil kommt von links herein. Er erscheint nur auf der Fläche und
     nimmt deshalb deren Gegenfarbe an: Schwarz auf Bernstein. */
  .dienst__pfeil {
    align-self: center;
    font-size: clamp(20px, 2.4vw, 30px);
    color: #0d0d0d;
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 300ms linear, transform 350ms var(--ease-out);
  }

  .dienst:hover .dienst__pfeil { opacity: 1; transform: none; }

  /* Ohne Zeigegerät gibt es kein Überfahren — dort steht der Text immer,
     und der Pfeil entfällt, weil er nichts mehr ankündigt. Dieselbe
     Entscheidung wie überall sonst auf dieser Seite. */
  @media (hover: none) {
    .dienst__pfeil { display: none; }
    .dienst__text { grid-template-rows: 1fr; margin-top: 0.8em; }
    .dienst__text p { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dienst,
    .dienst::before,
    .dienst__name,
    .dienst__nr { transition: none; }
  }

  /* ── 6 · Vorteile ─────────────────────────────────────────────────────── */
  /* Dieser Block ist am 6. August 2026 versehentlich mit dem
     Disziplinenfeld entfernt worden — er lag zwischen dessen Regeln und
     denen des Studio-Abschnitts, und der Schnitt lief einmal zu weit.
     Sichtbar wurde es als Liste mit Browser-Aufzählung: "1. 01", "2. 02". */
  .benefits__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .benefit { border-top: 1px solid var(--line); padding-top: var(--space-3); }

  /* Die drei Ziffern in Bernstein. Vorher stand hier --petrol, im
     Schwarzabschnitt also das helle Blau — sie waren damit die letzte
     blaue Auszeichnung unterhalb des Positionsabsatzes. Auf #0d0d0d
     stehen sie bei 10.83:1 statt bei 3.22. */
  .benefit__num {
    display: block;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--marke);
    margin-bottom: var(--space-2);
  }

  .benefit__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-1);
    text-wrap: balance;
  }

  /* Gedeckelt, damit die Zeile über die volle Breite nicht auf rund 90
     Zeichen läuft. Nebeneinander greift der Deckel nicht — dort sind die
     Spalten 266 bis 399px breit. */
  .benefit__text { max-width: 62ch; color: var(--ink-muted); }

  /* ── 6 · Studio ───────────────────────────────────────────────────────── */
  /* Der Abschnitt kappt waagerecht. Gebraucht wurde das von den
     Streublöcken, die ihren Text um 7rem zur Seite hereinfuhren und die
     Seite dabei auf 1326px Scrollbreite wachsen ließen. Die Kulisse, die
     seit dem 6. August 2026 an ihrer Stelle steht, bewegt sich seitlich
     nicht mehr — die Regel bleibt als Sicherung stehen.

     clip und nicht hidden: hidden macht aus dem Abschnitt einen
     Scrollcontainer, und da overflow-y sichtbar bleiben muss, würde der
     Browser daraus auto rechnen. clip kappt nur. Der Abschnitt läuft über
     die volle Fensterbreite, geschnitten wird also nichts, was man
     ohnehin sähe. */
  .team {
    overflow-x: clip;
    padding-inline: var(--edge);
  }

  /* Beide Kapitelwörter blenden auf ihrem Weg aus — das Skript am Ende
     der Datei schreibt die Deckkraft. Der Startwert steht hier, damit
     ohne Skript nichts fehlt. */
  .kapitelwort { opacity: 1; }

  /* Der Kopf steht enger, wo die Überschrift kurz ist und das Feld
     direkt darunter die Fläche übernimmt — bei "SERVICES". Studio trägt
     seit dem Umbau kein sec-head mehr, sondern das klebende Kapitelwort. */
  .sec-head--knapp { margin-bottom: clamp(1.75rem, 4vw, 3rem); }

  /* Vier Porträts: zwei Spalten auf dem Handy, vier ab 992px.

     Name und Rolle standen bis zum 5. August 2026 als zwei Zeilen unter
     dem Bild. Das gab der Reihe ein unruhiges Fußende — die Rollen sind
     Doppelnennungen, zwei von vieren brachen um, und die Reihe stand auf
     vier verschieden hohen Textblöcken. Jetzt sitzen sie im Bild, nach
     demselben Muster wie die Disziplinen weiter oben: Der Name ist immer
     da, die Rolle klappt beim Überfahren auf.

     Damit ändert sich auch das Format. Im Quadrat saß der Name auf Höhe
     von Kinn und Hals — bei Joscha und Tom stand er den Gesichtern
     buchstäblich im Weg. 4:5 gibt unterhalb des Kinns eine Fläche, auf
     die eine Zeile gehört. Der Ausschnitt kostet nichts: Die Vorlagen
     sind 700 × 700 und quadratisch beschnitten, 4:5 nimmt je Seite 70px
     ab. Die Köpfe stehen mittig und rund 300px breit, sie liegen also mit
     Abstand innerhalb. Nachgesehen an allen vier.

     ABSTAND UND GRÖSSE. Zwei Vorgaben stehen weiter fest: Die Reihe liegt
     bündig an beiden Kanten, und die Gesichter bleiben kleiner als die
     Stücke im Haufen darunter, damit sie ihn einleiten statt mit ihm zu
     konkurrieren. Der Spaltenabstand sinkt dafür von 137 auf 94px:

       3 × 94                 = 282px für die Abstände
       (1252 − 282) ÷ 4       = 243px je Bild

     bei 1252px Reihe also 243 × 303px gegen 210 × 300 vorher. Die Reihe
     ist damit genauso hoch wie zuvor mit den Textzeilen — der Abschnitt
     wiegt in der Seite unverändert schwer, nur sein Fußende ist ruhig.
     Und 243px stehen weiter unter den größten Haufenstücken, die bei
     derselben Fensterbreite 300 bis 330px messen.

     Der Versuch, den Überhang stattdessen nach außen zu legen (40px
     Abstand, 123px Einrückung je Seite), fiel schon früher durch: Die
     Reihe stand dann nicht mehr bündig. */
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Derselbe Abstand wie in der Kulisse darunter — die beiden Raster
       teilen sich ab 992px auch die Spalten. */
    gap: clamp(1rem, 2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__member { margin: 0; }

  /* container-type, weil die Beschriftung in cqi steht — sie hängt an der
     Kachel, nicht am Fenster. Das ist hier wichtiger als bei den
     Disziplinen: Die Team-Kacheln sind schmal, und eine rem-Größe wäre auf
     ihnen je nach Browser-Grundschrift mal knapp und mal zu breit.

     Ohne Maske und ohne Filter, wie bei Arbeiten und Disziplinen: Die
     Rundung ist null, und die Porträts stehen roh in Farbe. Die
     Graustufen, die die vier Aufnahmen zu einer Reihe banden, sind auf
     Simons Ansage vom 6. August 2026 entfallen. */
  .team__bild {
    position: relative;
    container-type: inline-size;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-bild);
  }

  .team__portrait {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: inherit;
  }

  /* Alles in cqi, also in Prozent der Kachelbreite. Bei 243px Kachel sind
     das 14,6px Rand, 18,5px Name und 13,9px Rolle. Weil Rand und Schrift
     an derselben Größe hängen, bleibt das Verhältnis in jeder Kachelbreite
     gleich: Der längste Name, "Cem-Pierre Schuch", füllt immer 84 % der
     verfügbaren Breite — nie mehr, nie weniger.

     Ausnahme ist das Band zwischen 992 und rund 1180px Fenster. Dort steht
     die Reihe schon vierspaltig, aber die Kachel misst erst 169 bis 200px,
     und in reinem cqi wäre der Name 12,8px klein. Deshalb die Untergrenzen
     in max(): 13,5px für den Namen, 11,5 für die Rolle. Bei 169px Kachel
     füllt der längste Name damit 91 % statt 84 — eng, aber er passt, und
     ab 1180px greift wieder die reine cqi-Rechnung.

     In px und nicht in rem: rem hinge an der Browser-Grundschrift, und die
     hat mit der Kachelbreite nichts zu tun. */
  .team__fuss {
    position: absolute;
    left: 6cqi;
    right: 6cqi;
    bottom: 5.2cqi;
    z-index: 1;
  }

  /* Gemischt und halbfett, nicht versal und extrafett wie die Disziplinen.
     Der Unterschied ist gewollt: "VIDEO" ist eine Marke und darf rufen, ein
     Mensch heißt einfach so. Versal käme "CEM-PIERRE SCHUCH" außerdem auf
     107 % der Kachelbreite und passte gar nicht. */
  .team__name {
    display: block;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: max(13.5px, 7.6cqi);
    line-height: 1.2;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }

  /* 0fr auf 1fr statt max-height: Damit läuft die Bewegung genau bis zur
     tatsächlichen Texthöhe. Zwei der vier Rollen brauchen zwei Zeilen,
     zwei kommen mit einer aus — der Name hebt sich also unterschiedlich
     weit an, und genau das soll er. */
  .team__role {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    font-size: max(11.5px, 5.7cqi);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    opacity: 0;
    transition: grid-template-rows var(--dur-slow) var(--ease-out),
                opacity var(--dur) var(--ease-out),
                margin-top var(--dur-slow) var(--ease-out);
  }

  .team__role > span { overflow: hidden; }

  /* Die beiden Hälften der Rolle stehen untereinander, der senkrechte
     Strich aus den Daten fällt weg.

     Er stand vorher zwischen ihnen, und bei zwei von vieren brach die
     Zeile genau dort um — "Head of Production |" mit hängendem Strich am
     Zeilenende, darunter "Self‑Shooting Director". Ein Trennzeichen, das
     nichts mehr trennt, weil der Umbruch die Arbeit schon getan hat.

     Gestapelt stehen alle vier gleich: zwei Zeilen, keine Striche, und der
     Name hebt sich auf jeder Kachel gleich weit an. Das ist auch der
     richtige Ton — in einer Produktion steht so der Abspann. */
  .team__zeile { display: block; }

  .team__member:hover .team__role,
  .team__member:focus-within .team__role {
    grid-template-rows: 1fr;
    margin-top: 3.4cqi;
    opacity: 1;
  }

  /* Ohne Zeigegerät gibt es kein Überfahren — dort steht die Rolle immer.
     Dieselbe Entscheidung wie bei den Disziplinen. */
  @media (hover: none) {
    .team__role {
      grid-template-rows: 1fr;
      margin-top: 3.4cqi;
      opacity: 1;
    }
  }

  /* UNTERHALB VON 560px ZURÜCK UNTER DAS BILD.

     Zweispaltig wird die Kachel auf dem Telefon schmal: bei 375px Fenster
     misst sie 155px. In cqi wäre der Name dort 11,8px und die Rolle 8,8 —
     unlesbar. Eine rem-Untergrenze hilft nicht, sie ließe den Namen über
     die Kachel hinauslaufen.

     Also fällt die Beschriftung dort zurück unter das Bild, wo sie umbrechen
     darf. Das kostet nichts: Der Aufklapper ist eine Hover-Geste, und ein
     Telefon hat keinen Zeiger. 560px ist die Stelle, an der die zweispaltige
     Kachel unter 236px fällt — darüber trägt die Schrift auf dem Bild.

     In px und nicht in rem, wie alle Umbruchstellen hier: rem hängt in
     Medienabfragen an der Browser-Grundschrift, nicht an der Seite. */
  @media (max-width: 559.98px) {
    /* Kappen aus: Steht die Beschriftung im Fluss statt darüber, ist sie
       Teil der Figur und würde an deren Unterkante beschnitten. */
    .team__bild { overflow: visible; }

    .team__fuss {
      position: static;
      margin-top: var(--space-2);
    }

    .team__name {
      font-size: var(--fs-small);
      color: var(--on-dark);
      text-shadow: none;
    }

    /* text-wrap: balance, weil die Rollen Doppelnennungen sind. Ohne die
       Angabe füllt die erste Zeile sich bis zum Rand und lässt ein
       einzelnes Wort darunter stehen. */
    .team__role {
      display: block;
      margin-top: 0;
      font-size: var(--fs-small);
      color: var(--on-dark-muted);
      opacity: 1;
      text-wrap: balance;
    }
  }

  /* ── Die Kulisse unter den Porträts ──────────────────────────────────── */
  /* Aufbau nach dem Culture-Abschnitt von saltandpictures.de: vier
     Spalten, versetzte Reihen, Graustufen mit Farbe beim Überfahren,
     unter jedem Stück eine Pille und ein Titel in der Redaktionsschrift.
     Ohne das klebende Riesenwort — die Überschrift des Abschnitts steht
     über den Porträts und bleibt dort.

     Der Abstand nach oben trennt die Kulisse von der Porträtreihe. Er
     stand bei 7/13vw/11rem, als darunter zwei Haufen mit auseinander
     laufenden Stücken kamen und das oberste Stück 98px über seine Fläche
     hinausragte. Das Feld steht jetzt still in seinen Kanten; die Hälfte
     reicht. */
  .kulisse {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    list-style: none;
    padding: 0;
  }

  /* Der Versatz je Spalte, wie bei Featured Work. Über data-spalte und
     nicht über :nth-child: Ein Textfeld belegt zwei Plätze, damit zählt
     :nth-child ab dort die Spalten falsch. Welches Stück in welcher
     Spalte landet, rechnet das Frontmatter mit — siehe kulisse dort.

     Die beiden Textfelder beginnen in Spalte 1 und 3 und stehen damit
     ohne Versatz; das ist Absicht, sie sollen an der Reihenkante sitzen
     und nicht mitschwimmen. */
  .kulisse > li { align-self: start; margin-top: var(--rutsch, 0); }
  .kulisse > li[data-spalte='2'] { --rutsch: 12vh; }
  .kulisse > li[data-spalte='4'] { --rutsch: 6vh; }

  .kulisse__stueck { display: grid; gap: 10px; }

  .kulisse__stueck img {
    width: 100%;
    aspect-ratio: var(--r, 3 / 4);
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  .kulisse__stueck:hover img { filter: none; }

  @media (hover: none) {
    .kulisse__stueck img { filter: none; }
  }

  .kulisse__zeile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 0.75rem;
    font-size: 12px;
    line-height: 1.5;
  }

  .kulisse__pille {
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .kulisse__nr {
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .kulisse__titel {
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(0.9375rem, 1.4vw, 1.25rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* DAS TEXTFELD IST EINE KACHEL, kein Absatz zwischen Kacheln: Es belegt
     eine Spalte und steht im Hochformat 3:4 wie die hochkanten Aufnahmen
     daneben. Oben ausgerichtet, damit die Doppellinie auf derselben Kante
     sitzt wie die Bildoberkanten in seiner Reihe.

     Die Linie unten schließt die Spalte ab und liegt auf der Unterkante
     der Kachel — also auf derselben Höhe wie die Unterkante eines
     hochkanten Nachbarbildes. Zwischen ihr und dem Textende steht Luft,
     und das ist Absicht: So sieht eine Zeitungsspalte aus, deren Artikel
     zu Ende ist. Ohne sie hörte der Text einfach im Schwarz auf. */
  .kulisse__satz {
    display: grid;
    align-content: start;
    aspect-ratio: 3 / 4;
    container-type: inline-size;
    border-bottom: 1px solid var(--line);
  }

  /* WAS EINEN ZEITUNGSSATZ AUSMACHT — und was davon hier steht:

       Ressortzeile   Über dem Artikel steht, wo man ist. Klein, versal,
                      weit gesperrt.
       Doppellinie    Die klassische Trennung unter dem Ressortkopf. 3px
                      double sind genau das: zwei Haarlinien mit einer
                      Haarlinie Abstand.
       Didone         Deutsche Zeitungen setzen ihre Schlagzeilen seit dem
                      19. Jahrhundert in Didone-Schnitten — Walbaum bei
                      der FAZ, Didot-Verwandte anderswo. Bodoni Moda ist
                      genau diese Gattung und im Projekt ohnehin die
                      Redaktionsschrift. Der Griff zur Serife ist hier
                      also kein Kostüm, sondern die vorhandene Rolle.
       Enge Spalte    35 bis 50 Zeichen je Zeile, knapper Durchschuss,
                      Silbentrennung an. Das ist der Grund, warum ein
                      Zeitungsabsatz so dicht aussieht — und der Grund,
                      warum der Fließtext klein bleiben muss.
       Initial        Der große Anfangsbuchstabe über zwei Zeilen. Im
                      Feuilleton der Normalfall.

     DER FLIESSTEXT BLEIBT KLEIN. Das ist die eine Entscheidung, an der
     alles hängt: Eine Zeitungsspalte sieht nach Zeitung aus, weil ihr
     Satz dicht ist — 35 bis 50 Zeichen je Zeile, knapper Durchschuss,
     Silbentrennung an. Das Skript am Ende der Datei sucht deshalb nicht
     mehr den Grad, mit dem der Text die Kachel füllt, sondern den größten
     Grad bis zu einem Deckel von 17px, bei dem er noch hineinpasst. Auf
     dem Schreibtisch greift der Deckel, auf dem Telefon der Platz.

     Die Kachel wird dadurch nicht voll, und das ist richtig so: Ein
     Artikel hört auf, wo er aufhört. Die Linie an der Unterkante macht
     daraus einen Spaltenschluss statt eines abgerissenen Absatzes.

     DIE ÜBERSCHRIFT STEHT ÜBER DEM SATZ und nicht daneben: 2,1em, also
     gut das Doppelte. Zwei Anläufe lagen daneben — 4-fach war eine
     Titelseite in einer Bildkachel, 1,05-fach war gar keine Überschrift
     mehr, sondern eine fette erste Zeile. Das Verhältnis stammt aus der
     Vorlage, die Simon geschickt hat: Dort trägt die Schlagzeile rund das
     2,2-fache des Fließtextes.

     DIE FLÄCHE IST WEG, und damit fällt der Grund weg, aus dem sie da
     war: Schrift auf Schwarz zwischen zwölf Fotos las sich als fehlendes
     Bild. Die Spalte hält den Platz jetzt anders — zwei Linien fassen sie
     oben und unten ein. Es ist kein Loch mehr, sondern ein Ausriss. */
  .notiz {
    display: grid;
    /* Startwert; den echten Grad setzt das Skript. Ohne Skript bleibt er
       stehen, und der Satz steht kleiner in der Kachel — aber vollständig
       und ohne Überlauf. */
    font-size: clamp(11px, 6.8cqi, 22px);
    border-top: 3px double rgba(255, 255, 255, 0.55);
    padding-top: 0.5em;
  }

  .notiz__ressort {
    font-family: var(--font-ui);
    font-size: 0.6em;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* ZWEI SCHRIFTEN IN EINER SPALTE, und genau so ist die Rollenteilung im
     Projekt gedacht: Poppins ist die Identität, Bodoni die Redaktion.
     Der Vorspann gehört zur Ansage, der Fließtext zum Artikel. In der
     Zeitung ist das dieselbe Trennung — Schlagzeilen in einer eigenen
     Schrift, der Satz darunter in der Brotschrift.

     Die Vorlage setzt ihre Schlagzeile in eine Serife. Hier steht Poppins,
     weil das so angefragt war — und es geht auf: 600 gegen 400, Grotesk
     gegen Serife, damit ist die Zeile ohne jeden Zweifel eine Überschrift
     und nicht die erste Zeile des Absatzes. Wer die Vorlage wörtlich will,
     tauscht hier eine Zeile: var(--font-editorial) und Gewicht 500.

     Die Silbentrennung greift hier selten, bleibt aber an: Bei einer
     schmalen Spalte und einer langen Zusammensetzung — "Produktionen" hat
     zwölf Zeichen — ist sie der Unterschied zwischen Umbruch und
     Überlauf. */
  .notiz__titel {
    /* em zählt hier den eigenen Grad, also 2,1-fach — 0.3em sind knapp
       0,63 Grundzeilen und nicht 0,3. */
    margin-top: 0.3em;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 2.1em;
    line-height: 1.12;
    letter-spacing: -0.025em;
    hyphens: auto;
    hyphenate-limit-chars: 8 4 4;
  }

  /* KEIN BLOCKSATZ — zum zweiten Mal, und diesmal mit Zahlen für jeden
     Grad. Er gehört zum Zeitungssatz, und die Vorlage hat ihn; hier
     scheitert er an der Textmenge. Gemessen wurde die größte Wortlücke in
     beiden Sätzen bei 321px Spaltenbreite:

       17px   15,2  und  24,5px      3 bzw. 4 Zeilen
       15px   26,0  und  13,0px      3 Zeilen
       13px    6,5  und  10,9px      2 bzw. 3 Zeilen
       11px    4,8  und   3,6px      2 Zeilen

     Brauchbar wird er erst bei 11px, und dort steht der Text so klein in
     der Kachel, dass 312 von 428px leer bleiben. Der Grund ist die Länge:
     Die beiden Sätze haben 100 und 120 Zeichen und ergeben drei Zeilen.
     Blocksatz braucht viele Zeilen und viele Fugen je Zeile, auf die sich
     der Rest verteilen kann — eine Zeitungsspalte hat dreißig Zeilen, wir
     haben drei. Was in der Vorlage ruhig aussieht, reißt hier Löcher.

     Also linksbündig, mit ausfransender rechter Kante. Die
     Silbentrennung bleibt und nimmt der Kante ihre Unruhe. Sie greift
     erst ab zwölf Zeichen und lässt links wie rechts mindestens fünf
     stehen — sonst zerlegt sie "worldwide" zu "worldwi-de", und ein
     englisches Wort nach deutschen Regeln getrennt sieht nach Fehler aus.
     Lange Komposita wie "Räumlichkeiten" trennt sie weiterhin, und das
     ist im Deutschen der Normalfall. */
  .notiz__text {
    margin-top: 0.85em;
    font-family: var(--font-editorial);
    font-size: 1em;
    line-height: 1.36;
    hyphens: auto;
    hyphenate-limit-chars: 12 5 5;
    color: rgba(255, 255, 255, 0.85);
  }

  /* HIER STAND EIN INITIAL, und es ist bewusst wieder raus. Zwei Gründe,
     beide am Bild geprüft:

     Erstens die Rangfolge. Seit die Schlagzeile nur noch 1,15em trägt,
     wäre der Anfangsbuchstabe mit 2em das Größte in der Kachel gewesen —
     ein Buchstabe, der lauter ruft als die Überschrift über ihm.

     Zweitens die Zeilenrechnung. Ein umflossenes Initial muss exakt so
     hoch sein wie ein Vielfaches der Zeilenhöhe, sonst ist die zweite
     Zeile halb eingerückt und halb nicht. Bei 2em und Zeilenhöhe 0,82
     stand der Kasten bei 1,64em gegen 1,34em Zeilenhöhe — also 1,2
     Zeilen. Das sah nach Fehler aus, nicht nach Satz.

     Was den Absatz als Zeitungsspalte lesbar macht, steht ohnehin schon
     da: die Ressortzeile, die Doppellinie, die Bodoni und der schwerere
     Schnitt im Vorspann. */

  /* Zwei Spalten, sobald das Feld unter etwa 200px je Stück fällt. Der
     Versatz entfällt dabei — zu zweit läse er sich als verrutschte
     Kachel. Das Textfeld behält auch hier seinen einen Platz; es ist eine
     Kachel unter Kacheln und keine Zeile quer durch das Feld. */
  @media (max-width: 859.98px) {
    .kulisse { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kulisse > li[data-spalte='2'],
    .kulisse > li[data-spalte='4'] { --rutsch: 0; }
  }
  /* ── 10 · FAQ ─────────────────────────────────────────────────────────── */
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .faq__head .label { margin-bottom: var(--space-2); }

  /* Jede Frage trägt ihre Nummer und füllt sich beim Überfahren von links
     mit dem Akzent — übernommen aus Entwurf 04c-XII, dieselbe Geste wie
     an der Kundenleiste weiter oben.

     Drei Teile:
       ::before    die Fläche, wächst von 0 auf volle Breite
       padding     die Zeile rückt dabei ein, der Text weicht dem Sweep
       counter     die Nummer geht von gedämpft auf voll

     overflow: hidden ist Bedingung — ohne es liefe die wachsende Fläche
     über die Zeile hinaus. Und .faq__item > * braucht position, sonst
     läge der Sweep über Text und Zeichen statt darunter.

     Der offene Zustand hält die Fläche: Eine aufgeklappte Antwort soll
     als geöffnet erkennbar bleiben, auch wenn der Zeiger weiterzieht. */
  .faq__list { counter-reset: faq; }

  /* Die Polsterung rechts ist nicht Kosmetik: Ohne sie sitzt das Plus
     exakt auf der rechten Kante der Zeile, und die Fläche endet mit ihm
     statt um ihn herum. Sie stand hier auf null, das Plus klebte an der
     Kante des Bernsteins. */
  .faq__item {
    position: relative;
    overflow: hidden;
    counter-increment: faq;
    padding-right: clamp(14px, 2vw, 28px);
    border-top: 1px solid var(--line);
    transition: padding-left 350ms var(--ease-out);
  }

  .faq__item:last-child { border-bottom: 1px solid var(--line); }

  /* Bernstein wie bei den Services: Die Farbe gehört auf dieser Seite
     dem, was man anfassen kann. Und wie dort dreht sie die Zeile um —
     Weiß stünde auf #FFB300 bei 1.79:1, Schwarz bei 10.83. */
  .faq__item::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 0;
    background: var(--marke);
    transition: width 350ms var(--ease-out);
  }

  .faq__item:hover::before,
  .faq__item[open]::before { width: 100%; }

  .faq__item:hover,
  .faq__item[open] { padding-left: clamp(18px, 2.4vw, 36px); }

  .faq__item > * { position: relative; }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    padding-block: var(--space-2);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
    transition: color 350ms var(--ease-out);
  }

  .faq__item:hover .faq__q,
  .faq__item[open] .faq__q { color: #0d0d0d; }

  /* Der Fokusring folgt mit: Auf der offenen Zeile liegt Bernstein, und
     der weiße Ring aus dem Schwarzabschnitt wäre dort nicht zu sehen.
     Eine offene Zeile behält die Fläche auch ohne Zeiger — genau dann
     kann sie den Fokus tragen. */
  .faq__item[open] .faq__q:focus-visible { outline-color: #0d0d0d; }

  /* Die Nummer in der Redaktionsschrift, kursiv — dieselbe Rolle wie die
     Ziffern der Gründe weiter oben. Sie steht vor der Frage und nicht
     hinter ihr, damit die fünf Zeilen eine gemeinsame Textkante haben.

     Als generierter Inhalt und nicht im Markup: Sie zählt nur, was
     ohnehin dasteht. Eine Sprachausgabe liest sie mit vor — "01, Was
     kostet eine Produktion" —, und das ist richtig so. */
  .faq__q::before {
    content: '0' counter(faq);
    flex-shrink: 0;
    margin-right: clamp(14px, 2.4vw, 32px);
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 20px);
    color: var(--ink-muted);
    transition: color 350ms var(--ease-out);
  }

  .faq__item:hover .faq__q::before,
  .faq__item[open] .faq__q::before { color: #0d0d0d; }

  /* Auf dem Bernstein ist das gedämpfte Weiß der Antworten nicht mehr zu
     lesen — 65 Prozent Deckung kämen dort auf 1.5:1. Schwarz steht bei
     10.83. */
  .faq__item:hover .faq__a,
  .faq__item[open] .faq__a { color: #0d0d0d; }

  /* Das Plus muss mit — es steht in derselben Farbe wie der Sweep und
     wäre auf ihm sonst schlicht verschwunden. Nicht knapp, sondern
     vollständig: gleiche Farbe auf gleicher Farbe ist 1:1. */
  .faq__item:hover .faq__icon::before,
  .faq__item:hover .faq__icon::after,
  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after { background: #0d0d0d; }

  @media (prefers-reduced-motion: reduce) {
    .faq__item,
    .faq__item::before,
    .faq__q,
    .faq__a,
    .faq__q::before { transition: none; }
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__icon { position: relative; flex-shrink: 0; width: 20px; height: 20px; }

  /* Das Plus in Bernstein: Es ist das Bedienelement der Zeile, und die
     Farbe gehört auf dieser Seite dem Bedienbaren. Auf #0d0d0d steht es
     bei 10.83:1 — die 3.0 für Bedienelemente sind damit weit übertroffen.
     Vorher stand hier --petrol, im Schwarzabschnitt also das helle Blau;
     ein blaues Plus über einer bernsteinfarbenen Zeile wäre die einzige
     Stelle gewesen, an der beide Farben dieselbe Sache meinen. */
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--marke);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }

  .faq__a {
    padding-bottom: var(--space-3);
    color: var(--ink-muted);
    max-width: 58ch;
  }

  /* ── 11 · Bottom-CTA ──────────────────────────────────────────────────── */
  /* Linksbündig wie alles ab der Kundenleiste. Zentriert stand der
     Abschluss sonst als einziger Block auf einer Achse, die die Seite
     sonst nirgends mehr hat. */
  .cta__inner { display: grid; justify-items: start; gap: var(--space-3); }
  .cta__title { max-width: 16ch; }

  /* DIE DREI WEGE als große Zeilen mit nachlaufendem Pfeil. Das Muster
     ist nicht neu erfunden, sondern von der Kontaktseite geholt: Dort
     stehen E-Mail und Telefon seit jeher so, als .contact__big. Der
     Abschluss der Startseite ist der Ort, an dem es trägt — die
     Überschrift stellt die Frage, die Zeilen darunter sind die Antworten.

     Hier standen zwei Knöpfe nebeneinander, "Projekt anfragen" auf
     bernsteinfarbener Fläche und die Adresse als Umriss. Beide sind zu
     Zeilen geworden. Bernstein ist deshalb nicht weg: Es sitzt jetzt im
     Überfahren, wie an jeder anderen anfassbaren Stelle dieser Seite.

     Größer als auf der Kontaktseite (dort 20 bis 28px): Diese Zeilen
     stehen unter einer Überschrift, die 60px trägt, und sind das Letzte,
     was die Seite sagt. Die Linien dazwischen sind dieselben Haarlinien
     wie an den Dienstzeilen und der FAQ. */
  .wege {
    display: grid;
    width: 100%;
    margin-top: var(--space-2);
    border-top: 1px solid var(--line);
  }

  .weg {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 88px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: clamp(1.375rem, 3.4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease-out);
  }

  .weg:hover { color: var(--marke); }

  /* Der Pfeil steht immer in Bernstein und nicht erst beim Überfahren:
     Er ist die Ansage, dass die Zeile irgendwohin führt. Beim Überfahren
     rückt er nach — dieselbe Bewegung wie auf der Kontaktseite, nur ein
     paar Pixel weiter, weil die Zeile hier größer ist. */
  .weg__pfeil {
    flex-shrink: 0;
    color: var(--marke);
    transition: transform var(--dur) var(--ease-out);
  }

  .weg:hover .weg__pfeil { transform: translateX(6px); }

  @media (prefers-reduced-motion: reduce) {
    .weg,
    .weg__pfeil { transition: none; }
  }

  /* ── Breakpoints ──────────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .hero__cue { display: inline-flex; }
  }

  @media (min-width: 992px) {
    /* Drei Gründe nebeneinander erst ab 992. Bei 768px war eine Spalte
       204px breit — rund 24 Zeichen je Zeile, und die Überschrift
       "Inhaltliche Substanz" füllte sie schon allein. Ab 992 sind es 266px
       und bei 1440 dann 399. */
    .benefits__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    /* Vier Porträts über die volle Breite, bündig an beiden Kanten. Der
       Beide Raster des Abschnitts teilen sich ab hier die Spalten: vier
       Spalten, derselbe Abstand wie in der Kulisse darunter. Vorher lief
       die Reihe auf einer eigenen Rechnung — Abstand
       clamp(26px, 15.18vw - 124.6px, 94px) — und ihre Spaltenkanten lagen
       17 bis 48px neben denen der Kulisse. Nachgemessen bei 1440px:

         Porträts   36 · 398 · 759 · 1121
         Kulisse    36 · 381 · 727 · 1073

       Das ist der Fall, der am unruhigsten wirkt: zwei Raster, die sich
       fast treffen. Sichtbar wird es nicht als Versatz, sondern als
       Gefühl, die Gesichter seien zu schwer für das, was folgt.

       DAS PORTRÄT FÜLLT SEINE SPALTE NICHT AUS. Auf voller Spaltenbreite
       wäre es 317px — breiter als heute und genauso breit wie die
       Kulissenstücke. Auf drei Vierteln sind es 238 x 297px. Gemessen an
       der Fläche:

         Porträt vorher      268 x 335    90k
         Porträt jetzt       238 x 297    71k
         Kulisse quer        317 x 306    97k
         Kulisse hoch        317 x 491   156k

       Die Gesichter sind damit das leichteste Bild des Abschnitts, ihre
       linken Kanten liegen aber genau auf den Spalten der Kulisse.

       Nur ab 992px: Zweispaltig darunter füllt das Porträt seine Spalte,
       sonst stünden zwei Briefmarken nebeneinander.

       Nur hier und nicht an .team__grid: Zweispaltig wäre derselbe Wert
       eine Lücke, kein Abstand. */
    .team__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    /* Die Gesichter stehen nicht auf einer Linie, sondern im selben Takt
       wie die Kulisse darunter: zweite Spalte tief, vierte auf halbem
       Weg. Dadurch greifen die beiden Felder ineinander, statt als zwei
       Blöcke übereinanderzuliegen — die Reihe fällt nicht mehr als
       gerade Kante zu dem heraus, was folgt.

       Dieselben Werte wie bei .kulisse > li, und das ist der Punkt: Ein
       eigener Takt wäre ein zweites Muster im selben Raster. */
    .team__member { align-self: start; margin-top: var(--rutsch, 0); }
    .team__member:nth-child(2) { --rutsch: 12vh; }
    .team__member:nth-child(4) { --rutsch: 6vh; }

    /* Das Porträt füllt seine Spalte. Es stand einen Tag lang auf drei
       Vierteln davon, linksbündig — gedacht als Rhythmus, gelesen als
       Fehler: Am vierten Gesicht fiel das freie Viertel mit dem
       Seitenrand zusammen, und die Reihe stand links auf 36px, rechts
       auf 115. Alles andere auf der Seite schließt beidseitig bündig ab.

       Damit ist die Reihe wieder so breit wie die Kulisse darunter —
       317px je Kachel bei 1440. Bündig und auf einem Raster geht nur
       zusammen: Kleiner ginge es nur über einen größeren Abstand, und
       der verschöbe die Spalten wieder gegen die Kulisse. */
  }

  /* FAQ zweispaltig ab 1024: Die Antworten wuerden in einer 768er Breite
     auf 20 Zeichen je Zeile zusammenlaufen. */
  @media (min-width: 1024px) {
    .faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(3rem, 6vw, 6rem); }
    .faq__head { position: sticky; top: 7rem; }
  }

  /* ── Der Zeiger ───────────────────────────────────────────────────────── */
  /* Aus Entwurf 21 (julienpianetti.com): Der Mauspfeil verschwindet, an
     seiner Stelle läuft eine Scheibe mit Nachlauf mit. Über einer Arbeit
     geht sie zu einer Fläche auf und trägt "View".

     mix-blend-mode: difference — deshalb ist sie weiß und trotzdem auf
     jedem Grund zu sehen: Auf dem schwarzen Teil bleibt sie weiß, auf
     der hellen Positionsfläche kehrt sie sich zu Schwarz um. Eine feste
     Farbe wäre auf einer der beiden Flächen verschwunden.

     Drei Bedingungen, alle drei nötig:

       hover: hover        Ein Touchgerät hat keinen Zeiger, den man
                           ersetzen könnte — dort bliebe nur eine
                           Scheibe in der Bildmitte stehen.
       pointer: fine       Ein grober Zeiger (Fernbedienung, Stift)
                           trifft eine 10px-Scheibe nicht.
       no-preference       Wer weniger Bewegung angefordert hat, behält
                           den Mauspfeil des Systems. Ein Zeiger mit
                           Nachlauf ist Bewegung, und zwar dauernde.

     z-index über dem Menü: Bei 200 lag die Scheibe hinter dem
     geöffneten Menü — und weil der Mauspfeil ausgeblendet ist, hätte
     man dort gar keinen Zeiger mehr gehabt. */
  .zeiger { display: none; }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(body),
    :global(a),
    :global(button),
    :global(summary) { cursor: none; }

    .zeiger {
      position: fixed;
      left: 0;
      top: 0;
      z-index: calc(var(--z-overlay) + 100);
      display: grid;
      place-items: center;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #fff;
      mix-blend-mode: difference;
      pointer-events: none;
      transform: translate(-50%, -50%);
      transition: width 300ms var(--ease-out), height 300ms var(--ease-out);
      will-change: left, top;
    }

    /* Schwarz auf der weißen Scheibe: Durch die Umkehrung wird daraus
       auf dunklem Grund weiße Schrift auf weißer Scheibe — und die ist
       schwarz, weil die Scheibe selbst schon umgekehrt ist. */
    .zeiger span {
      font-family: var(--font-ui);
      font-size: 13px;
      font-weight: 500;
      color: #000;
      white-space: nowrap;
      opacity: 0;
      transition: opacity 200ms linear;
    }

    .zeiger.is-gross { width: 92px; height: 92px; }
    .zeiger.is-gross span { opacity: 1; }

    /* Die Scheibe bleibt groß, auch über einer Pille — die Pille legt sich
       stattdessen über sie. Warum, steht bei .werk__pille:hover. */
  }

  /* ── Reduced Motion ───────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    /* Hier stand die Ausnahme für das Logo-Laufband: Ohne Bewegung blieb
       ein Großteil der Logos unsichtbar, also wurde der Streifen von Hand
       scrollbar. Das Band ist weg, die Kundschaft steht jetzt als Raster —
       das braucht keine Ausnahme, es bewegt sich ohnehin nicht. */
    .hero__cue { animation-name: none; opacity: 1; }

    /* Der Auftritt entfällt, der Satz steht sofort. */
    .hero__zeile > span { opacity: 1; transform: none; animation-name: none; }
    .hero__media video { animation-name: none; transform: none; }

    /* Die Texte erscheinen weiterhin beim Überfahren, die Zeile geht nur
       nicht mehr auf, sondern steht sofort. Sie ganz wegzulassen wäre
       falsch: Reduzierte Bewegung heißt weniger Bewegung, nicht weniger
       Inhalt. Gilt für die Beschreibungen der Dienste wie für die Rollen
       im Studio-Abschnitt. */
    .dienst__text,
    .dienst__text p,
    .team__role { transition: opacity var(--dur-fast) linear; }

    /* Der Positionsabsatz steht vollständig aufgefärbt, ohne Scrollverlauf;
       die Meta-Zeile bekommt ihre Deckung zurück. Das Skript prüft
       dieselbe Abfrage und rührt beide dann nicht mehr an. */
    .statement__text :global(.wort) { color: var(--akzent); transition: none; }
    .statement__leistung { --auf: 1; }
    .statement__meta { opacity: 1; }
  }
</style>

<script>
  // Der Positionsabsatz färbt sich beim Scrollen Wort für Wort auf.
  //
  // Die Wörter stehen von Anfang an — nichts blendet ein, nichts
  // verschiebt sich. Nur die Schriftfarbe läuft von einem Fünftel Deckung
  // auf volles Blau, und zwar der Reihe nach: Wie weit der Absatz durch
  // den Bildschirm gewandert ist, bestimmt, wie viele Wörter schon
  // stehen. Das Aufteilen muss das Skript machen, weil CSS keinen
  // Zugriff auf einzelne Wörter hat.
  //
  // Rekursiv über die Kindknoten und nicht über innerHTML: Der Absatz
  // enthält em, i und die Wortmarke; ein Ersetzen der Zeichenkette
  // zerstörte sie. So bleibt jedes Element erhalten und bekommt seine
  // Wörter einzeln verpackt.
  const absatz = document.querySelector<HTMLElement>('.statement__text');
  const metaZeile = document.querySelector<HTMLElement>('.statement__meta');
  const ruhigerAbsatz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (absatz && !ruhigerAbsatz) {
    const zerlegen = (knoten: Node) => {
      Array.from(knoten.childNodes).forEach((kind) => {
        if (kind.nodeType === Node.TEXT_NODE) {
          const teil = document.createDocumentFragment();
          // Der Trenner steht in der Klammer, damit die Leerzeichen im
          // Ergebnis bleiben — sonst klebten die Wörter aneinander.
          (kind.textContent ?? '').split(/(\s+)/).forEach((stueck) => {
            if (!stueck) return;
            if (/^\s+$/.test(stueck)) {
              teil.appendChild(document.createTextNode(stueck));
            } else {
              const wort = document.createElement('span');
              wort.className = 'wort';
              wort.textContent = stueck;
              teil.appendChild(wort);
            }
          });
          knoten.replaceChild(teil, kind);
        } else if (kind.nodeType === Node.ELEMENT_NODE) {
          zerlegen(kind);
        }
      });
    };

    zerlegen(absatz);
    const woerter = Array.from(absatz.querySelectorAll<HTMLElement>('.wort'));

    // Die Leistung am Satzende bekommt ihren eigenen Fortschritt: Sie
    // färbt sich stufenlos auf, während die übrigen Wörter der Reihe nach
    // umspringen. Er läuft über die zweite Hälfte des Absatzlaufs — früher
    // anzufangen brächte nichts, denn solange die Wörter davor gedimmt
    // sind, hebt sich das Satzende von nichts ab.
    const leistung = absatz.querySelector<HTMLElement>('.statement__leistung');

    // WANN DER LAUF FERTIG IST, ist der Punkt: Der Absatz soll voll
    // aufgefärbt dastehen, während er mitten im Bild steht — nicht erst,
    // wenn man längst bei Featured Work angekommen ist.
    //
    // Die alte Rechnung lief über eine feste Strecke (Absatzhöhe plus 42
    // Prozent Fensterhöhe) und war deshalb erst fertig, wenn die
    // Oberkante des Absatzes auf 111px stand — also fast am oberen
    // Bildrand, gemessen bei 1440 x 900. Zu dem Zeitpunkt ist der Absatz
    // schon halb aus dem Bild.
    //
    // Jetzt stehen Anfang und Ende als Lagen und nicht als Länge:
    //
    //   Anfang   Oberkante auf 90 Prozent der Fensterhöhe — der Absatz
    //            betritt gerade das Bild
    //   Ende     Absatz steht mittig, seine Mitte auf der Bildmitte
    //
    // Daraus ergibt sich die Strecke von selbst, und sie stimmt auch
    // dann, wenn der Absatz höher ist als das Fenster: Auf dem Telefon
    // steht er 21 Zeilen hoch, das Ende liegt dann rechnerisch über der
    // Bildmitte, und der Lauf ist entsprechend länger.
    let angefordert = 0;

    const rechnen = () => {
      angefordert = 0;
      const kasten = absatz.getBoundingClientRect();
      const anfang = window.innerHeight * 0.9;
      const ende = (window.innerHeight - kasten.height) / 2;
      const strecke = Math.max(1, anfang - ende);
      const anteil = Math.min(1, Math.max(0, (anfang - kasten.top) / strecke));
      const stehen = Math.round(anteil * woerter.length);

      woerter.forEach((wort, i) => wort.classList.toggle('is-an', i < stehen));

      // Die Phrase färbt über die zweite Hälfte des Laufs auf. Früher
      // anzufangen brächte nichts: Solange die Wörter davor noch gedimmt
      // sind, gibt es nichts, wovon sie sich abheben könnte.
      if (leistung) {
        leistung.style.setProperty(
          '--auf',
          String(Math.min(1, Math.max(0, (anteil - 0.45) / 0.5)))
        );
      }

      // Die Meta-Zeile kommt zum Schluss: Sie blendet über das letzte
      // Viertel des Laufs ein und steht damit, wenn der Absatz steht.
      if (metaZeile) {
        metaZeile.style.opacity = String(Math.min(1, Math.max(0, (anteil - 0.72) / 0.28)));
      }
    };

    const anstossen = () => {
      if (!angefordert) angefordert = requestAnimationFrame(rechnen);
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen, { passive: true });
    rechnen();
  }
</script>

<script>
  // Der Header folgt dem Hell-Dunkel-Schnitt.
  //
  // Ab "Featured Work" läuft die Seite auf Schwarz. Die solide Fläche des
  // Headers ist bis dahin weiß und muss ab dem Schnitt schwarz werden,
  // sonst steht ein weißer Balken über schwarzem Grund.
  //
  // Bezug ist die Oberkante des Abschnitts gegen die Höhe des Headers:
  // Sobald sie darunter liegt, steht schwarzer Grund hinter dem Header.
  const kopf = document.getElementById('site-header');
  const schnitt = document.querySelector('.section.work');

  if (kopf && schnitt) {
    let angefordertKopf = 0;

    const kopfPruefen = () => {
      angefordertKopf = 0;
      kopf.classList.toggle('is-dunkel', schnitt.getBoundingClientRect().top <= kopf.offsetHeight);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!angefordertKopf) angefordertKopf = requestAnimationFrame(kopfPruefen);
      },
      { passive: true }
    );

    kopfPruefen();
  }
</script>

<script>
  // Ein Video lässt sich per CSS nicht anhalten. Wer reduzierte Bewegung
  // angefordert hat, bekommt deshalb ein Standbild statt der Schleife.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (heroVideo) {
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

    const anwenden = () => {
      if (ruhig.matches) {
        heroVideo.removeAttribute('autoplay');
        heroVideo.loop = false;
        heroVideo.pause();
      } else {
        heroVideo.loop = true;
        // play() kann abgelehnt werden, etwa im Energiesparmodus —
        // dann bleibt schlicht das erste Bild stehen.
        void heroVideo.play().catch(() => {});
      }
    };

    anwenden();
    ruhig.addEventListener('change', anwenden);
  }
</script>

<script>
  // Der Satz auf der Bühne blendet beim Scrollen aus — übernommen aus
  // Entwurf 04c-XII.
  //
  // Der Weg ist eine knappe halbe Fensterhöhe: Nach 45 Prozent ist der
  // Satz weg, und das ist genau die Strecke, nach der der Positionsabsatz
  // darunter ins Bild kommt. Zwei Aussagen sollen sich nicht überlagern.
  //
  // Der Pfeil geht doppelt so schnell (p * 2). Er ist eine Aufforderung
  // zu scrollen und hat sich erledigt, sobald jemand scrollt.
  const buehnenSatz = document.querySelector<HTMLElement>('.hero__statement');
  const buehnenPfeil = document.querySelector<HTMLElement>('.hero__cue');

  if (buehnenSatz) {
    const sanft = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let angefordert = 0;

    const buehnenBild = () => {
      angefordert = 0;
      const p = Math.max(0, Math.min(1, window.scrollY / (window.innerHeight * 0.45)));
      buehnenSatz.style.opacity = (1 - p).toFixed(3);
      // Der Weg nur ohne Bewegungsvorbehalt; das Ausblenden bleibt, denn
      // es ist kein Weg, sondern ein Übergang.
      if (sanft) buehnenSatz.style.transform = `translateY(${(-p * 28).toFixed(1)}px)`;
      if (buehnenPfeil) buehnenPfeil.style.opacity = (1 - Math.min(1, p * 2)).toFixed(3);
    };

    window.addEventListener(
      'scroll',
      () => { if (!angefordert) angefordert = requestAnimationFrame(buehnenBild); },
      { passive: true }
    );

    buehnenBild();
  }
</script>

<script>
  // Der Zeiger — übernommen aus Entwurf 21 (julienpianetti.com).
  //
  // Eine Scheibe folgt dem Zeiger mit Nachlauf und geht über einer Arbeit
  // zu einer Fläche mit Beschriftung auf. Welche Beschriftung, steht am
  // Element in data-zeiger; damit hängt das Wort am Inhalt und nicht im
  // Skript.
  //
  // Die Bedingung ist dieselbe wie im Stylesheet und muss es auch sein:
  // Ohne sie liefe die Schleife auf einem Telefon dauerhaft mit, während
  // die Scheibe dort gar nicht sichtbar ist.
  const zeiger = document.querySelector<HTMLElement>('.zeiger');
  const zeigerWort = zeiger?.querySelector('span');
  const zeigerErlaubt = window.matchMedia(
    '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)'
  );

  if (zeiger && zeigerWort && zeigerErlaubt.matches) {
    // Ziel ist die Position des echten Zeigers, x und y laufen ihr nach.
    // 0.28 je Bild ist der Wert aus der Vorlage: schnell genug, dass die
    // Scheibe nicht hinterherhinkt, langsam genug, dass man den Nachlauf
    // sieht.
    let zielX = window.innerWidth / 2;
    let zielY = window.innerHeight / 2;
    let x = zielX;
    let y = zielY;

    window.addEventListener(
      'pointermove',
      (e) => { zielX = e.clientX; zielY = e.clientY; },
      { passive: true }
    );

    const laufen = () => {
      x += (zielX - x) * 0.28;
      y += (zielY - y) * 0.28;
      zeiger.style.left = `${x}px`;
      zeiger.style.top = `${y}px`;
      requestAnimationFrame(laufen);
    };

    requestAnimationFrame(laufen);

    // pointerenter/-leave und nicht mouseover/-out: Die beiden steigen
    // nicht auf, die Scheibe bliebe sonst groß, sobald der Zeiger über
    // ein Kindelement der Kachel fährt.
    document.querySelectorAll<HTMLElement>('[data-zeiger]').forEach((el) => {
      el.addEventListener('pointerenter', () => {
        zeigerWort.textContent = el.dataset.zeiger ?? '';
        zeiger.classList.add('is-gross');
      });
      el.addEventListener('pointerleave', () => zeiger.classList.remove('is-gross'));
    });

  }
</script>

<script>
  // Die beiden Kapitelwörter blenden auf ihrem Weg aus.
  //
  // "Featured Work" und "Studio" kleben oben und wandern über ihr
  // Bildfeld. Ohne Ausblenden stehen sie bis zur letzten Kachel voll da
  // und werden zur Fläche, die man wegsieht. Sie gehen deshalb nach gut
  // der Hälfte der Strecke weg — angesagt ist das Feld, nicht mehr die
  // Überschrift.
  //
  // DIE STRECKE ist nicht der Abschnitt, sondern das, was das Wort
  // tatsächlich klebt: Abschnittshöhe minus Fensterhöhe. Bei einem
  // Abschnitt, der kürzer als das Fenster ist, gibt es keine — dann
  // bleibt das Wort deckend.
  //
  //   0 bis 55 %    voll da
  //   55 bis 85 %   blendet aus
  //   ab 85 %       weg, die letzten Kacheln stehen allein
  const woerter = Array.from(
    document.querySelectorAll<HTMLElement>('.kapitelwort')
  ).map((wort) => ({ wort, abschnitt: wort.closest('section') as HTMLElement }));

  if (woerter.length) {
    let angefordertWort = 0;

    const wortBild = () => {
      angefordertWort = 0;
      for (const { wort, abschnitt } of woerter) {
        const r = abschnitt.getBoundingClientRect();
        const lauf = r.height - window.innerHeight;
        if (lauf <= 0) { wort.style.opacity = '1'; continue; }
        const p = Math.min(1, Math.max(0, -r.top / lauf));
        const aus = Math.min(1, Math.max(0, (p - 0.55) / 0.3));
        wort.style.opacity = (1 - aus).toFixed(3);
      }
    };

    window.addEventListener(
      'scroll',
      () => { if (!angefordertWort) angefordertWort = requestAnimationFrame(wortBild); },
      { passive: true }
    );
    window.addEventListener('resize', wortBild, { passive: true });

    wortBild();
  }
</script>

<script>
  // Die beiden Zeitungsspalten bleiben in Zeitungsgröße.
  //
  // Gesucht ist je Kachel der größte Grad für die Spalte, bei dem sie noch
  // vollständig hineinpasst — höchstens aber 17px. Ressortzeile,
  // Überschrift und Fließtext hängen in em daran und wachsen mit, es gibt
  // also nur eine Schraube.
  //
  // DER DECKEL IST DIE EIGENTLICHE SCHRAUBE. Ohne ihn füllt der Text die
  // Kachel bis auf den letzten Pixel und steht bei 30px — das ist kein
  // Zeitungssatz mehr, sondern ein Plakat. Er stand deshalb erst bei 17px,
  // und dort blieben von 428px Kachelhöhe 188 leer. Bei 22px sind es noch
  // 88 und 58: Die Spalte reicht weit nach unten, und über der
  // Schlusslinie bleibt Luft. Nachgemessen bei 321px Spaltenbreite:
  //
  //   17px   3 bzw. 4 Zeilen, 33/29 Zeichen   188 und 205px leer
  //   20px   4 Zeilen, 25/29 Zeichen          119 und 119px leer
  //   22px   4 bzw. 5 Zeilen, 25/23 Zeichen    88 und  58px leer
  //   24px   passt nicht mehr, die Kachel wächst auf 484px
  //
  // Auf dem Telefon greift nicht der Deckel, sondern der Platz: Bei einer
  // 168px breiten Kachel passen 22px nicht mehr, der Suchlauf landet
  // deutlich darunter. Deshalb wird überhaupt gesucht und nicht einfach
  // ein fester Wert gesetzt.
  //
  // Rechnen lässt sich das nicht: Die beiden Sätze sind unterschiedlich
  // lang, die Kachel misst je nach Fenster zwischen 217 und 435px, und wo
  // eine Zeile umbricht, hängt an der Schrift und an der Silbentrennung.
  // Also gemessen — eine Intervallhalbierung über zwölf Schritte trifft
  // den Grad auf ein Hundertstel Pixel genau.
  //
  // ZWEI PRÜFUNGEN STATT EINER. Die Höhe entscheidet fast immer, aber die
  // Schlagzeile kann auch in der Breite anstoßen: "Produktionen" ist zwölf
  // Zeichen lang. Die Silbentrennung im CSS fängt das ab, die
  // Breitenprüfung hier ist das Netz darunter.
  //
  // Gemessen wird der Kasten der Spalte und nicht scrollHeight: Die
  // Doppellinie ist ein Rahmen, und Rahmen zählt scrollHeight nicht mit.
  // Drei Pixel klingen nach nichts, entscheiden bei knappem Stand aber
  // über eine ganze Zeile.
  //
  // ERST KLEIN STELLEN, DANN DEN PLATZ MESSEN. aspect-ratio ist keine
  // harte Grenze: Ist der Inhalt höher, wächst die Kachel mit. Wer dann
  // ihre Höhe abfragt, misst seinen eigenen Überlauf und findet immer,
  // dass alles passt — die Kachel blieb bei 447 statt 428px stehen und
  // riss die Reihe mit. Auf 1px gestellt trägt der Inhalt nichts mehr
  // bei, und die Kachel fällt auf die Höhe zurück, die ihr Verhältnis
  // vorgibt. Das ist der Platz, um den es geht.
  const kacheln = document.querySelectorAll<HTMLElement>('.kulisse__satz');

  if (kacheln.length) {
    const einpassen = () => {
      for (const kachel of kacheln) {
        const notiz = kachel.querySelector<HTMLElement>('.notiz');
        const titel = kachel.querySelector<HTMLElement>('.notiz__titel');
        if (!notiz || !titel) continue;

        notiz.style.fontSize = '1px';
        const platz = kachel.clientHeight;
        if (platz <= 0) continue;

        let klein = 8;
        let gross = 22;
        for (let i = 0; i < 12; i++) {
          const mitte = (klein + gross) / 2;
          notiz.style.fontSize = `${mitte}px`;
          const passt =
            notiz.getBoundingClientRect().height <= platz &&
            titel.scrollWidth <= titel.clientWidth;
          if (passt) klein = mitte;
          else gross = mitte;
        }

        // ABGERUNDET UND NICHT GERUNDET. toFixed rundet zur nächsten
        // Stelle, also auch nach oben — und oben liegt hier die Kante, um
        // die es die ganze Zeit geht. Gemessen: Der Suchlauf endete bei
        // 29,547px mit einer Spaltenhöhe von 398px, toFixed(2) machte
        // daraus 29,55px, und bei 29,55 bricht eine Zeile mehr um: 438px
        // gegen 428px Platz. Die Kachel wuchs um zehn Pixel und riss ihre
        // Reihe mit. Drei Tausendstel Pixel Unterschied, eine Zeile
        // Wirkung.
        notiz.style.fontSize = `${Math.floor(klein * 100) / 100}px`;
      }
    };

    // Erst wenn Bodoni steht: Mit der Ersatzschrift fällt die Messung
    // anders aus, und der Grad wäre nach dem Schriftwechsel falsch.
    if (document.fonts?.ready) document.fonts.ready.then(einpassen);
    else einpassen();

    let angefordertPass = 0;
    window.addEventListener(
      'resize',
      () => { if (!angefordertPass) angefordertPass = requestAnimationFrame(() => { angefordertPass = 0; einpassen(); }); },
      { passive: true }
    );
  }
</script>
